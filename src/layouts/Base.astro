---
import { ClientRouter } from 'astro:transitions';
import Veil from '../components/Veil.astro';
import { pillars } from '../data/site';
import { analytics, site } from '../config';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** preset names for pages without chapters, e.g. "connect" */
  sequence?: string;
  /** keep private tools out of search engines */
  noindex?: boolean;
}
const {
  title,
  description = 'Sarvakali: devotion, witchcraft, healing, identity, divination and learning.',
  sequence = 'hero',
  noindex = false,
} = Astro.props;

// link previews: each page has its own picture, made from the real page by tools/make-og.mjs
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const ogName = path === '' ? 'home' : path.replace(/^\//, '').replace(/\//g, '-');
const ogImage = new URL(`/og/${ogName}.jpg`, site.url).href;
const pageUrl = new URL(path || '/', site.url).href;
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060304" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sarvakali" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link id="search-src" rel="prefetch" href="/search-index.json" as="fetch" crossorigin="anonymous" />
    {analytics.provider === 'cloudflare' && analytics.id && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analytics.id })}></script>}
    {analytics.provider === 'umami' && analytics.id && analytics.src && <script defer src={analytics.src} data-website-id={analytics.id}></script>}
    {analytics.provider === 'plausible' && analytics.id && <script defer src="https://plausible.io/js/script.js" data-domain={analytics.id}></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=Tiro+Devanagari+Sanskrit&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" />
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        try {
          if (sessionStorage.getItem('sk-intro-seen') && location.search.indexOf('intro') < 0) h.dataset.intro = 'seen';
          var q = new URLSearchParams(location.search);
          var hero = q.get('hero') || sessionStorage.getItem('sk-x-hero');
          h.dataset.heroVariant = hero === 'name' || hero === 'dawn' || hero === 'eye' ? hero : 'dawneye';
          var page = q.get('page') || sessionStorage.getItem('sk-x-page');
          h.dataset.pageStyle = page || 'eye';
          if (q.has('og')) h.dataset.og = '1';
        } catch (e) {
          h.dataset.heroVariant = 'dawneye';
        }
      })();
    </script>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the content</a>
    <div id="world" transition:persist="world" aria-hidden="true">
      <div class="world-fallback"></div>
      <canvas id="world-canvas"></canvas>
    </div>
    <canvas id="incense" class="incense" transition:persist="incense" aria-hidden="true"></canvas>

    <header class="site-header">
      <a class="wordmark" href="/" transition:name="sk-wordmark" data-pt>Sarvakali</a>
      <nav class="site-nav" aria-label="Main">
        <button type="button" class="icon-btn" data-search-open aria-label="Search all services (shortcut: /)" aria-controls="search">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
        <div class="sky" data-sky>
          <button type="button" class="sky-pill" data-sky-btn aria-expanded="false" aria-controls="sky-card">
            <span class="sky-icon" data-sky-icon></span><span class="sky-name" data-sky-name>Moon</span>
          </button>
          <div id="sky-card" class="sky-card" data-sky-card hidden>
            <p class="sky-title" data-sky-title></p>
            <p data-sky-note></p>
          </div>
        </div>
        <button type="button" class="sound-btn" data-sound aria-pressed="false" aria-label="Ambient sound">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path class="sound-waves" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path class="sound-off" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <span class="sound-label">Sound</span>
        </button>
        <button type="button" class="icon-btn menu-btn" data-menu-open aria-expanded="false" aria-controls="menu">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          <span class="menu-label">Menu</span>
        </button>
        <a class="btn btn-solid btn-sm book-btn" href="/connect">Book<span class="book-long"> a session</span></a>
      </nav>
    </header>

    <nav id="menu" class="menu" aria-label="All pages" hidden>
      <div class="menu-inner">
        <ul class="menu-main">
          <li><a href="/">Home</a></li>
          <li><a href="/path">Find your path</a></li>
          <li><a href="/practice">Daily practice</a></li>
          <li><a href="/writings">Writings</a></li>
          <li><a href="/about">About Sarvakali</a></li>
          <li><a href="/connect">Request a conversation</a></li>
        </ul>
        <div class="menu-side">
          <p class="menu-label-sm">The six pillars</p>
          <ul>{pillars.map((p) => <li><a href={`/pillars/${p.slug}`}>{p.name}</a></li>)}</ul>
          <p class="menu-label-sm">Good to know</p>
          <ul>
            <li><a href="/care">Boundaries and care</a></li>
            <li><a href="/care#privacy">Your privacy</a></li>
          </ul>
          <p class="menu-label-sm">Prototype extras</p>
          <ul>
            <li><a href="/depth">AI depth demo</a></li>
            <li><a href="/invoice">Invoice maker (for Sarvakali)</a></li>
          </ul>
        </div>
        <button type="button" class="menu-close" data-menu-close aria-label="Close the menu">×</button>
      </div>
    </nav>

    <div id="search" class="search" role="dialog" aria-modal="true" aria-label="Search all services" hidden>
      <div class="search-panel">
        <div class="search-bar">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          <label class="sr-only" for="search-input">Search all services</label>
          <input id="search-input" type="search" placeholder="Search: protection, love, tarot, reiki…" autocomplete="off" spellcheck="false" />
          <button type="button" class="search-close" data-search-close aria-label="Close search">Esc</button>
        </div>
        <p class="search-status" data-search-status aria-live="polite"></p>
        <ul class="search-results" data-search-results></ul>
        <div hidden>{pillars.map((p) => <a data-pillar-href={p.slug} href={`/pillars/${p.slug}`} tabindex="-1">{p.name}</a>)}</div>
      </div>
    </div>

    <div class="keep" data-keep-root hidden>
      <button type="button" class="keep-pill" data-keep-open aria-expanded="false" aria-controls="keep-drawer">Your list <b data-keep-count>0</b></button>
      <div id="keep-drawer" class="keep-drawer" data-keep-drawer role="dialog" aria-label="Your list" hidden>
        <p class="keep-title">Your list</p>
        <p class="keep-hint">Kept on this device only. Sarvakali sees it when you send a request.</p>
        <ul class="keep-items" data-keep-items></ul>
        <div class="keep-actions">
          <a class="btn btn-solid btn-sm" href="/connect" data-keep-ask>Ask about these</a>
          <button type="button" class="btn btn-ghost btn-sm" data-keep-clear>Clear</button>
          <button type="button" class="btn btn-ghost btn-sm" data-keep-close>Close</button>
        </div>
      </div>
    </div>

    <slot name="overlay" />

    <main id="main" data-sequence={sequence}>
      <slot />
    </main>

    <Veil />

    <dialog id="card-dialog" class="card-dialog" aria-label="Today's card">
      <div class="card-wrap">
        <div class="card3d" role="button" tabindex="0" aria-label="Turn the card">
          <div class="card3d-inner">
            <div class="card-face card-back" aria-hidden="true">
              <svg viewBox="0 0 200 300">
                <rect x="10" y="10" width="180" height="280" rx="10" fill="none" stroke="currentColor" stroke-width="1.2" />
                <rect x="18" y="18" width="164" height="264" rx="7" fill="none" stroke="currentColor" stroke-width="0.6" />
                <g transform="translate(100 150)" fill="none" stroke="currentColor" stroke-width="1">
                  <circle r="62" /><circle r="54" stroke-width="0.6" />
                  <path d="M0 -46 L40 23 L-40 23 Z" /><path d="M0 46 L40 -23 L-40 -23 Z" />
                  <path d="M0 -30 L26 15 L-26 15 Z" stroke-width="0.7" />
                  <circle r="4" fill="currentColor" />
                  <g stroke-width="0.7">{Array.from({ length: 16 }, (_, i) => <path d="M0 -62 Q6 -72 0 -82 Q-6 -72 0 -62Z" transform={`rotate(${i * 22.5})`} />)}</g>
                </g>
              </svg>
            </div>
            <div class="card-face card-front">
              <p class="card-kicker">Today's card</p>
              <svg class="card-glyph" viewBox="0 0 100 100" aria-hidden="true"><path data-card-glyph d="" /></svg>
              <h2 class="card-name" data-card-name></h2>
              <p class="card-line" data-card-line></p>
            </div>
          </div>
        </div>
        <p class="card-status" data-card-status aria-live="polite"></p>
        <div class="card-actions">
          <button type="button" class="btn btn-solid btn-sm" data-card-flip>Turn the card</button>
          <button type="button" class="btn btn-ghost btn-sm" data-card-share>Share</button>
          <button type="button" class="btn btn-ghost btn-sm" data-card-close>Close</button>
        </div>
        <p class="card-note">Prototype: the twelve cards and their words are placeholders for Sarvakali's own deck.</p>
      </div>
    </dialog>

    <dialog id="report-dialog" class="report-dialog" aria-label="Device report">
      <div class="report-inner">
        <p class="keep-title">Test this device</p>
        <p class="keep-hint" data-report-step>Measuring… keep this page open for about 15 seconds.</p>
        <textarea data-report-text readonly rows="14" aria-label="Device report"></textarea>
        <div class="keep-actions">
          <button type="button" class="btn btn-solid btn-sm" data-report-copy disabled>Copy the report</button>
          <button type="button" class="btn btn-ghost btn-sm" data-report-close>Close</button>
        </div>
      </div>
    </dialog>

    <div class="toast" data-toast role="status" hidden>
      <p data-toast-text></p>
      <button type="button" class="btn btn-ghost btn-sm" data-toast-action hidden></button>
      <button type="button" class="toast-close" data-toast-close aria-label="Dismiss">×</button>
    </div>

    <div id="cursor" class="cursor" transition:persist="cursor" aria-hidden="true">
      <span class="cursor-flame"></span>
      <span class="cursor-dot"></span>
    </div>

    <aside id="hud" class="hud" transition:persist="hud" data-open="true" aria-label="Prototype panel">
      <button type="button" class="hud-toggle" data-hud-toggle aria-expanded="true">Prototype</button>
      <div class="hud-body">
        <dl class="hud-stats">
          <div><dt>Quality</dt><dd data-hud-tier>…</dd></div>
          <div><dt>Frame rate</dt><dd data-hud-fps>…</dd></div>
          <div><dt>Points of light</dt><dd data-hud-points>…</dd></div>
          <div><dt>Atmosphere</dt><dd data-hud-chapter>…</dd></div>
        </dl>

        <div class="hud-group">
          <p class="hud-label">Quality</p>
          <div class="hud-seg" role="group" aria-label="Quality level">
            <button type="button" data-tier-btn="auto">Auto</button>
            <button type="button" data-tier-btn="ultra">Ultra</button>
            <button type="button" data-tier-btn="full">Full</button>
            <button type="button" data-tier-btn="lighter">Lighter</button>
            <button type="button" data-tier-btn="still">Still</button>
            <button type="button" data-tier-btn="calm">Calm</button>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Hero</p>
          <div class="hud-seg" role="group" aria-label="Hero" data-x="hero">
            <button type="button" data-v="dawneye">Eye at dawn</button>
            <button type="button" data-v="eye">Living eye</button>
            <button type="button" data-v="name">Name of light</button>
            <button type="button" data-v="dawn">Dawn</button>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Festival days</p>
          <div class="hud-seg" role="group" aria-label="Festival days" data-x="festival">
            <button type="button" data-v="auto">By date</button>
            <button type="button" data-v="kalipuja">Kali Puja</button>
            <button type="button" data-v="diwali">Diwali</button>
            <button type="button" data-v="navratri">Navratri</button>
            <button type="button" data-v="eclipse">Eclipse</button>
            <button type="button" data-v="none">None</button>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Living sky</p>
          <div class="hud-seg" role="group" aria-label="Living sky" data-x="sky">
            <button type="button" data-v="now">Tonight</button>
            <button type="button" data-v="amavasya">Amavasya</button>
            <button type="button" data-v="purnima">Purnima</button>
            <button type="button" data-v="night">Night</button>
            <button type="button" data-v="day">Day</button>
            <button type="button" data-v="off">Off</button>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Page change</p>
          <div class="hud-seg" role="group" aria-label="Page change" data-x="page">
            <button type="button" data-v="eye">Eye</button>
            <button type="button" data-v="smoke">Smoke</button>
            <button type="button" data-v="ink">Ink</button>
            <button type="button" data-v="morph">Morph titles</button>
            <button type="button" data-v="fade">Fade</button>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Cursor</p>
          <div class="hud-seg" role="group" aria-label="Cursor" data-x="cursor">
            <button type="button" data-v="flame">Flame</button>
            <button type="button" data-v="incense">Incense smoke</button>
            <button type="button" data-v="off">Normal</button>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Living forms</p>
          <div class="hud-seg" role="group" aria-label="Living forms" data-x="forms">
            <button type="button" data-v="on">On</button>
            <button type="button" data-v="off">Off</button>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Motion and touch</p>
          <div class="hud-seg" role="group" aria-label="Motion and touch">
            <button type="button" data-toggle="touch">Touchable forms</button>
            <button type="button" data-toggle="dust">Headings to dust</button>
            <button type="button" data-toggle="bend">Scroll bend</button>
            <button type="button" data-toggle="haptics">Vibration</button>
            <button type="button" data-tilt hidden>Phone tilt</button>
          </div>
          <p class="hud-note" data-tilt-note hidden></p>
        </div>

        <div class="hud-group">
          <p class="hud-label">Data saver</p>
          <div class="hud-seg" role="group" aria-label="Data saver">
            <button type="button" data-toggle="saver">Pretend data saver is on</button>
          </div>
          <p class="hud-note" data-saver-note></p>
        </div>

        <div class="hud-group">
          <p class="hud-label">Try</p>
          <div class="hud-links">
            <a href="/path">Find your path</a>
            <a href="/practice">Daily practice</a>
            <button type="button" data-card-open>Draw today's card</button>
            <button type="button" data-search-open>Search</button>
            <a href="/writings">Writings</a>
            <a href="/about">About</a>
            <a href="/care">Boundaries and care</a>
            <a href="/invoice">Invoice maker</a>
            <a href="/depth">AI depth demo</a>
          </div>
        </div>

        <div class="hud-group">
          <p class="hud-label">Real phones</p>
          <button type="button" class="hud-replay" data-device-test>Test this device</button>
          <p class="hud-note">Measures smoothness on each quality level and writes a report to copy and send back.</p>
        </div>

        <button type="button" class="hud-replay" data-hud-replay>Replay the intro</button>
      </div>
    </aside>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
