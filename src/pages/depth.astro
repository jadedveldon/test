---
import Base from '../layouts/Base.astro';

const works = [
  { id: '116', title: 'Kali standing on Shiva', img: '/depth/kali-116.jpg', depth: '/depth/kali-116-depth.png', w: 1100, h: 1420, link: 'https://clevelandart.org/art/2003.116' },
  { id: '163', title: 'Kali, unfinished study', img: '/depth/kali-163.jpg', depth: '/depth/kali-163-depth.png', w: 1100, h: 1755, link: 'https://clevelandart.org/art/2003.163' },
];
---
<Base title="AI depth · Sarvakali" sequence="loader" description="A flat painting given depth by an AI model, as a demo for the Sarvakali site.">
  <section class="depth" data-depth>
    <div class="depth-copy">
      <p class="kicker" data-hero>Demo · AI depth</p>
      <h1 class="display-l" data-hero data-split>A painting you can look into</h1>
      <p class="lede" data-hero>
        This is a flat painting. An AI model (Depth Anything V2) worked out how near or far each part of it is, once,
        ahead of time. The page then lets you look around it. Move your mouse, drag, or tilt your phone.
      </p>
      <div class="depth-controls" data-hero>
        <div class="hud-seg depth-seg" role="group" aria-label="Painting">
          {works.map((w, i) => <button type="button" data-work={w.id} aria-pressed={i === 0 ? 'true' : 'false'}>{w.title}</button>)}
        </div>
        <div class="hud-seg depth-seg" role="group" aria-label="View">
          <button type="button" data-depth-view aria-pressed="false">Show what the AI saw</button>
          <button type="button" data-depth-tilt hidden>Use phone tilt</button>
        </div>
      </div>
      <p class="hint" data-hero>
        How it could be used: the institute's own Kali artwork, altar or murti photographs could open into depth like this,
        on the pillar pages or in the intro. The model runs before publishing, so visitors only download two small pictures.
      </p>
      <p class="credit" data-hero>
        Paintings: Kalighat school, Calcutta, 19th century. Cleveland Museum of Art, public domain (CC0).
        {works.map((w) => <><a href={w.link} rel="noopener" target="_blank">{w.id === '116' ? '2003.116' : '2003.163'}</a>{' '}</>)}
      </p>
    </div>

    <figure class="depth-stage" data-hero>
      {works.map((w, i) => (
        <div class="depth-work" data-work-pane={w.id} hidden={i !== 0} style={`aspect-ratio: ${w.w} / ${w.h}`}>
          <img class="depth-img" src={w.img} alt={`${w.title}, Kalighat painting, 19th century`} width={w.w} height={w.h} loading={i === 0 ? 'eager' : 'lazy'} />
          <img class="depth-map" src={w.depth} alt="" aria-hidden="true" width={w.w} height={w.h} loading="lazy" hidden />
        </div>
      ))}
      <canvas class="depth-canvas" aria-hidden="true"></canvas>
    </figure>
  </section>
</Base>
