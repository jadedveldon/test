---
/**
 * Daily practice: "What brings you here today?" Three ways in, each a short guided practice made for one need:
 * today's practice (one for each planetary day), being with a deity or figure (of many traditions), working with a
 * feeling (with a care note first), or practice with no deity at all. Then the visitor's own practice (their record, the practices they have done, their kept
 * mantras), and, behind all that, the library, the seven days, the tools and the traditions for anyone who wants more.
 * The practices: src/content/practices ("Guided practices"); the words: src/content/pages/practice.json.
 */
import Base from '../layouts/Base.astro';
import CareText from '../components/CareText.astro';
import w from '../content/pages/practice.json';
import lib from '../content/pages/library.json';
import { DAYS, DAY_GLYPH, DAY_HEX, loadMantras, loadPractices, practicePath, summary, type DayKey } from '../data/mantras';

const H = w.hub;
const practices = await loadPractices();
const deities = practices.filter((p) => p.kind === 'deity');
const feelings = practices.filter((p) => p.kind === 'feeling');
const open = practices.filter((p) => p.kind === 'open');
const days = DAY_KEYS_ORDER(practices.filter((p) => p.kind === 'day'));
function DAY_KEYS_ORDER(ps: typeof practices) { return DAYS.map((d) => ps.find((p) => p.key === d.key)).filter(Boolean) as typeof practices; }
const all = await loadMantras();
// what the page's script needs: the days and the mantras in short (src/scripts/practice-journey.ts), and the practices' names
const weekData = {
  days: DAYS.map((d) => ({ key: d.key, name: d.name, sanskrit: d.sanskrit, planet: d.planet, planetSanskrit: d.planetSanskrit, question: d.question, intention: d.intention, themes: d.themes, opening: d.opening, closing: d.closing, practice: d.practice })),
  mantras: summary(all),
  badges: { guidance: lib.labels.guidance, variant: lib.labels.variant, verify: lib.labels.verify },
  practices: practices.map((p) => ({ slug: p.slug, title: p.title, kind: p.kind })),
};
const door = (k: string) => w.doors.find((d) => d.key === k) ?? w.doors[0];
const mins = (n: number) => H.minutes.replace('{n}', String(n));
---
<Base title="Daily practice · Sarvakali" sequence="practice" description="Guided daily practices with Sarvakali: today's practice, a practice with a deity, or one for how you feel.">
  <div data-practice data-practice-hub>
    <a hidden data-connect-href href="/connect" tabindex="-1" aria-hidden="true"></a>
    <script type="application/json" data-practice-words set:html={JSON.stringify(w)} />
    <script type="application/json" data-practice-week set:html={JSON.stringify(weekData)} />

    <!-- what brings you here -->
    <section class="chapter" data-chapter="practice">
      <div class="chapter-inner">
        <p class="kicker" data-hero>{w.kicker}<span data-today-hide hidden> · <span data-today-day></span> · <span data-today-planet></span></span></p>
        <h1 class="display-l" data-hero data-split>{w.title}</h1>
        <p class="lede" data-hero>{w.lede}</p>
        <ul class="doors" data-hero>
          {(['today', 'deities', 'feelings', 'open'] as const).map((k, i) => (
            <li><a class="door" href={`#${k}`}><span class="door-n" aria-hidden="true">{['☉', '❦', '♡', '◌'][i]}</span><b>{door(k).title}</b><span>{door(k).text}</span><span class="door-go" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
        <dl class="today today-sm" data-today data-hero>
          <div><dt>{w.today.moon}</dt><dd><span data-today-moon-icon></span><span data-today-moon>…</span></dd></div>
          <div><dt>{w.today.next}</dt><dd data-today-next>…</dd></div>
          <div><dt>{w.today.you}</dt><dd data-today-you>{w.today.none}</dd></div>
        </dl>
      </div>
    </section>

    <!-- today's practice -->
    <section class="chapter" data-chapter="lampsNight" id="today">
      <div class="chapter-inner">
        <p class="kicker" data-fade>{H.todayKicker}</p>
        <div class="day-feature" data-fade>
          {days.map((p) => {
            const d = DAYS.find((x) => x.key === p.key)!;
            return (
              <article class="dayf" data-day-feature={p.key} style={`--dc:${DAY_HEX[p.key as DayKey]}`}>
                <p class="dayf-glyph" aria-hidden="true">{DAY_GLYPH[p.key as DayKey]}</p>
                <div>
                  <h2 class="display-l">{d.name}</h2>
                  <p class="dayf-planet">{d.planet} · {d.planetSanskrit}</p>
                  <p class="lede">{p.intro}</p>
                  <blockquote class="pday-question"><p class="kicker">{w.today.question}</p><p>{d.question}</p></blockquote>
                  <div class="cta-row"><a class="btn btn-solid" href={practicePath(p.slug)}>{p.title} · {mins(p.minutes)}</a><a class="btn btn-ghost" href={`/practice/${p.key}`}>{w.today.dayMantras.replace('{day}', d.name)}</a></div>
                </div>
              </article>
            );
          })}
        </div>
        <nav class="week-strip day-other" aria-label={H.otherDay} data-fade>
          <span class="hint">{H.otherDay}:</span>
          {DAYS.map((x) => <a href={practicePath(x.key)} data-week-day={x.key} style={`--dc:${DAY_HEX[x.key as DayKey]}`}><span class="ws-glyph" aria-hidden="true">{DAY_GLYPH[x.key as DayKey]}</span><span class="ws-name">{x.name.slice(0, 3)}</span></a>)}
        </nav>
      </div>
    </section>

    <!-- with a deity -->
    <section class="chapter" data-chapter="devC_home" id="deities">
      <div class="chapter-inner">
        <p class="kicker" data-fade>{H.deitiesKicker}</p>
        <h2 class="display-l" data-split>{H.deitiesTitle}</h2>
        <p class="lede" data-fade>{H.deitiesLede}</p>
        <ul class="pr-cards" data-fade>
          {deities.map((p) => (
            <li><a class="pr-card pr-deity" href={practicePath(p.slug)} data-practice-card={p.slug}>
              {p.sanskrit ? <span class="pr-sk" lang={p.lang} aria-hidden="true">{p.sanskrit}</span> : null}
              <b>{p.key}</b>{p.tradition && p.tradition !== 'Hindu' ? <i class="pr-trad">{p.tradition}</i> : null}<span>{p.line}</span><small>{mins(p.minutes)} <em data-done-badge hidden></em></small>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- with a feeling -->
    <section class="chapter" data-chapter="care" id="feelings">
      <div class="chapter-inner">
        <p class="kicker" data-fade>{H.feelingsKicker}</p>
        <h2 class="display-l" data-split>{H.feelingsTitle}</h2>
        <p class="lede" data-fade>{H.feelingsLede}</p>
        <div class="pday-care" data-fade><CareText text={lib.care} /></div>
        <ul class="pr-cards" data-fade>
          {feelings.map((p) => (
            <li><a class="pr-card pr-feeling" href={practicePath(p.slug)} data-practice-card={p.slug}>
              <b>{p.title}</b><span>{p.line}</span><small>{mins(p.minutes)} <em data-done-badge hidden></em></small>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- without a deity -->
    <section class="chapter" data-chapter="care" id="open">
      <div class="chapter-inner">
        <p class="kicker" data-fade>{H.openKicker}</p>
        <h2 class="display-l" data-split>{H.openTitle}</h2>
        <p class="lede" data-fade>{H.openLede}</p>
        <ul class="pr-cards" data-fade>
          {open.map((p) => (
            <li><a class="pr-card pr-feeling" href={practicePath(p.slug)} data-practice-card={p.slug}>
              <b>{p.key}</b><span>{p.line}</span><small>{mins(p.minutes)} <em data-done-badge hidden></em></small>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- the visitor's own practice -->
    <section class="chapter" data-chapter="practice" id="yours">
      <div class="chapter-inner">
        <p class="kicker" data-fade>{H.yoursKicker}</p>
        <h2 class="display-l" data-split>{H.yoursTitle}</h2>
        <p class="lede" data-fade>{w.log.lede}</p>
        <div class="practice-two-col">
          <div class="plog" data-log data-fade></div>
          <div class="yours-side" data-fade>
            <div class="mine"><h3 class="display-s">{H.doneTitle}</h3><div data-done-list data-none={H.doneNone} data-times={H.doneTimes}><p class="hint">{H.doneNone}</p></div></div>
            <div class="mine"><h3 class="display-s">{w.mine.title}</h3><p class="hint">{w.mine.lede}</p><div data-mine></div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- going deeper -->
    <section class="chapter" data-chapter="library" id="deeper">
      <div class="chapter-inner">
        <p class="kicker" data-fade>{H.deeperKicker}</p>
        <h2 class="display-m" data-fade>{H.deeperTitle}</h2>
        <ul class="pr-cards pr-cards-sm" data-fade>
          {H.deeper.map((d) => <li><a class="pr-card" href={d.href}><b>{d.title}</b><span>{d.text}</span></a></li>)}
        </ul>
        <p class="cta-row" data-fade><button type="button" class="btn btn-ghost btn-sm" data-card-open>{w.card}</button></p>
      </div>
    </section>
  </div>
</Base>
