---
/**
 * Terms and refunds: what clients can expect, what is asked of them, booking, paying, moving and cancelling,
 * refunds, and complaints. Words: src/content/pages/terms.json ("Terms and refunds" in the content editor); the
 * bracketed lines are Sarvakali's to fill in (legal name, address, grievance officer, city). A draft for a lawyer to
 * review before launch. The care note comes first.
 */
import Base from '../layouts/Base.astro';
import Rich from '../components/Rich.astro';
import CareText from '../components/CareText.astro';
import { crumbWords as cw } from '../config';
import t from '../content/pages/terms.json';

const sections = t.sections.filter((s) => s.title.trim() && (s.paras.some((p) => p.trim()) || s.points.some((p) => p.trim())));
const slug = (s: { id?: string; title: string }, i: number) => (s.id?.trim() || s.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || `part-${i + 1}`);
---
<Base title="Terms and refunds · Sarvakali" sequence="care" description={t.lede} crumbs={[{ label: t.kicker || 'Terms and refunds' }]}>
  <article class="page terms">
    <header class="page-hero">
      <p class="kicker" data-hero>{t.kicker}</p>
      <h1 class="display-l" data-hero data-split>{t.title}</h1>
      <p class="lede" data-hero>{t.lede}</p>
      {t.updated.trim() && <p class="hint" data-hero>{t.updated}</p>}
      {t.draftNote.trim() && <p class="proto-flag" data-hero>{t.draftNote}</p>}
    </header>

    <div class="terms-layout">
      <nav class="terms-toc" aria-label={t.contents || 'On this page'} data-fade>
        <p class="kicker">{t.contents}</p>
        <ol>{sections.map((s, i) => <li><a href={`#${slug(s, i)}`}>{s.title}</a></li>)}</ol>
      </nav>
      <div class="prose page-body">
        {t.care.trim() && <section class="care-box" data-fade><p><CareText text={t.care} /></p></section>}
        {sections.map((s, i) => (
          <section data-fade aria-labelledby={slug(s, i)}>
            <h2 id={slug(s, i)}>{s.title}</h2>
            {s.paras.filter((p) => p.trim()).map((p) => <p><Rich text={p} /></p>)}
            {s.points.some((p) => p.trim()) && <ul>{s.points.filter((p) => p.trim()).map((p) => <li><Rich text={p} /></li>)}</ul>}
          </section>
        ))}
      </div>
    </div>
  </article>
</Base>
