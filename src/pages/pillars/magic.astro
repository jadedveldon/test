---
/**
 * Pillar 2, Witchcraft & Magic · the gilded grimoire.
 * One book with two kinds of page: bright parchment day pages (the grimoire)
 * and black-and-emerald night pages in gold (the alchemical sky). Between them
 * the night spreads in like ink. Hecate, one of Sarvakali's presiding deities,
 * opens the pillar at her crossroads; then a sigil, then the seven chapters
 * (the catalogue's seven categories).
 */
import Base from '../../layouts/Base.astro';
import SubCards from '../../components/SubCards.astro';
import { pillars, categoryCount } from '../../data/site';
import { CHAPTERS, HECATE, RITUS, SABBATS, SATURN, SIGIL_METHODS, SUB_ICON } from '../../data/magic';

const index = pillars.findIndex((p) => p.slug === 'magic');
const p = pillars[index];
const prev = pillars[(index + pillars.length - 1) % pillars.length];
const next = pillars[(index + 1) % pillars.length];
const anchor = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII'];
const moves = CHAPTERS.map((ch) => ({ ...ch, cat: p.categories.find((c) => c.name === ch.category)! }));
const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const pos = (deg: number, r: number) => { const a = (deg * Math.PI) / 180; return [Math.cos(a) * r, Math.sin(a) * r]; };

// Hecate's workings live in the Devotion catalogue (Greek deities); they are gathered here too
const devotion = pillars.find((x) => x.slug === 'devotion')!;
const hecateWork = devotion.categories.flatMap((c) => c.subs).flatMap((s) => s.items).filter((it) => /(^|[^A-Za-z])Hecate([^A-Za-z]|$)/.test(it));

// the three roads, drawn small beside her name
const roads = [-90, 30, 150].map((d) => pos(d, 30).map((v) => v.toFixed(1)).join(' '));
---
<Base title={`${p.name} · Sarvakali`} sequence="magG_hero" description={p.line}>
  <div class="mg" data-magic data-blend="edge">

    <!-- night · the opening, at Hecate's crossroads -->
    <section class="chapter mg-hero mg-night" data-chapter="magG_hero" data-mag-chapter="hero">
      <div class="chapter-inner mg-hero-grid">
        <div class="mg-hero-copy">
          <a class="back-link" href="/#paths">← All pillars</a>
          <p class="kicker" data-hero>Pillar {index + 1} of {pillars.length} · {p.count} services</p>
          <h1 class="display-l mg-title" data-hero data-split transition:name="pt-magic" data-pt>{p.name}</h1>
          <p class="lede" data-hero>{p.line}</p>
          <a class="mg-presides" href="#hecate" data-hero>
            <svg viewBox="-40 -40 80 80" aria-hidden="true"><circle r="36" class="mp-ring" />{roads.map((r) => <path d={`M0 0 L${r}`} />)}<circle r="5" class="mp-light" /></svg>
            <span><small>Under the keeping of</small> Hecate</span>
          </a>
          <ol class="mg-index" data-hero aria-label="The chapters of this book">
            <li class="is-night"><a href="#hecate"><span class="mg-num" aria-hidden="true">✦</span><span class="mg-ix-title">Hecate, presiding goddess</span></a></li>
            <li class="is-day"><a href="#make-a-sigil"><span class="mg-num" aria-hidden="true">✦</span><span class="mg-ix-title">Make a sigil</span></a></li>
            {moves.map((m, i) => (
              <li class={`is-${m.page}`}>
                <a href={`#${anchor(m.category)}`}>
                  <span class="mg-num" aria-hidden="true">{ROMAN[i]}</span>
                  <span class="mg-ix-title">{m.title}</span>
                  <span class="mg-ix-n">{categoryCount(m.cat)} services</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- night · Hecate -->
    <section class="chapter mg-move mg-night mg-hecate" id="hecate" data-chapter="magG_hecate" data-mag-chapter="hecate">
      <div class="chapter-inner mg-inner">
        <header class="mg-head">
          <p class="kicker" data-fade>Presiding goddess</p>
          <h2 class="display-l hk-name" data-split data-dust>Hecate</h2>
          <p class="hk-greek" lang="grc" data-fade>Ἑκάτη</p>
        </header>

        <figure class="hk-words" data-fade>
          <blockquote>
            {HECATE.words.map((w) => <p>{w}</p>)}
          </blockquote>
          <figcaption>
            <p>{HECATE.wordsLine}</p>
            <p class="hk-draft">In Sarvakali’s words · a placeholder until Sarvakali writes these lines</p>
          </figcaption>
        </figure>

        <div class="hk-supper" data-supper data-fade>
          <svg class="hk-moon" viewBox="-60 -60 120 120" aria-hidden="true">
            <circle r="44" class="hk-moon-disc" /><circle r="44" class="hk-moon-rim" /><circle r="54" class="hk-moon-halo" />
            {[-90, 30, 150].map((d) => { const [x, y] = pos(d, 54); const [x2, y2] = pos(d, 44); return <line x1={x2.toFixed(1)} y1={y2.toFixed(1)} x2={x.toFixed(1)} y2={y.toFixed(1)} class="hk-moon-road" />; })}
          </svg>
          <div class="hk-supper-copy">
            <h3>{HECATE.supper.title}</h3>
            <p>{HECATE.supper.text}</p>
            <p class="hk-when">Next dark moon: <span data-supper-when>shown when the page has loaded</span></p>
            <div class="cta-row">
              <button type="button" class="btn btn-ghost btn-sm" data-supper-cal>Add the next three to your calendar</button>
              <a class="btn btn-ghost btn-sm" href="/connect" data-topic="A working on the dark moon">Ask about a dark-moon working</a>
            </div>
            <p class="hk-note">{HECATE.supper.note} <a href={HECATE.supper.href} target="_blank" rel="noopener">About the Deipnon</a></p>
          </div>
        </div>

        <div class="hk-work" data-fade>
          <p class="kicker">Workings in her name · {hecateWork.length}</p>
          <ul class="sub-chips">
            {hecateWork.map((it) => <li><button type="button" class="chip-keep" data-keep={it} data-keep-p={devotion.name} aria-pressed="false">{it === 'Hecate' ? 'Hecate working' : it}</button></li>)}
          </ul>
          <p class="hk-also">Hecate also stands among <a href="/pillars/devotion#the-greek-gods">the Greek gods, in Devotion</a>, and watches over the doorways in <a href="#protection-cleansing-and-uncrossing">Protection</a>.</p>
        </div>
      </div>
    </section>

    <!-- day · make a sigil, five ways -->
    <section class="chapter mg-move mg-day mg-sigil-sec" id="make-a-sigil" data-chapter="magG_sigil" data-mag-chapter="sigil">
      <div class="chapter-inner mg-sigil-grid">
        <header class="mg-head">
          <p class="kicker" data-fade>Begin with an intention</p>
          <h2 class="display-l" data-split data-dust>Make a sigil</h2>
          <p class="lede" data-fade>Write what you wish for in a few words, then choose a way to turn it into a sigil. The same words give a different shape each way, and each is sealed in wax.</p>
          <div class="sg-methods" role="group" aria-label="Ways of making a sigil" data-fade>
            {SIGIL_METHODS.map((m, i) => <button type="button" data-sigil-method={m.key} aria-pressed={i === 0 ? 'true' : 'false'}>{m.name}</button>)}
          </div>
          <div class="sg-method-note" data-fade aria-live="polite">
            <p class="sg-how" data-sigil-how>{SIGIL_METHODS[0].how}</p>
            <p class="sg-origin" data-sigil-origin>{SIGIL_METHODS[0].origin}</p>
          </div>
          <p class="hk-note" data-fade>Sarvakali may make sigils differently. Nothing you type or draw here is saved or sent.</p>
        </header>
        <div class="sigil-maker" data-sigil data-method={SIGIL_METHODS[0].key} data-fade>
          <svg viewBox="-130 -130 260 260" class="sigil-svg" data-sigil-svg aria-label="Your sigil" role="img">
            <circle r="122" class="sg-gild" /><circle r="114" class="sg-ring" />
            {Array.from({ length: 52 }, (_, k) => { const [x1, y1] = pos(k * (360 / 52), 114); const [x2, y2] = pos(k * (360 / 52), k % 2 ? 118 : 121); return <line x1={x1.toFixed(1)} y1={y1.toFixed(1)} x2={x2.toFixed(1)} y2={y2.toFixed(1)} class="sg-tick" />; })}
            <g class="sg-board" data-board="wheel">
              <circle r="88" class="sg-ring thin" />
              {LETTERS.map((L, i) => { const [x, y] = pos(-90 + (i * 360) / 26, 101); return <text x={x.toFixed(1)} y={(y + 3.5).toFixed(1)} class="sg-letter" data-letter={L}>{L}</text>; })}
            </g>
            <g class="sg-board" data-board="square">
              <rect x="-78" y="-78" width="156" height="156" class="sg-cell" />
              <path d="M-26 -78V78M26 -78V78M-78 -26H78M-78 26H78" class="sg-cell" />
              {SATURN.map((row, r) => row.map((n, c) => <text x={(c - 1) * 52 + 16} y={(r - 1) * 52 + 21} class="sg-num" data-num={n}>{n}</text>))}
            </g>
            <g class="sg-board" data-board="draw"><circle r="88" class="sg-ring thin" /></g>
            <g class="sg-mark" data-sigil-mark></g>
            <g transform="translate(94 94)">
              <g class="sg-seal" data-sigil-seal transform="scale(0)">
                <circle r="27" class="sg-wax" /><circle r="20" class="sg-wax-ring" />
                {roads.map((r) => <path class="sg-wax-mark" d={`M0 0 L${r.split(' ').map((v) => (Number(v) * 0.45).toFixed(1)).join(' ')}`} />)}
                <circle r="3.2" class="sg-wax-dot" />
              </g>
            </g>
          </svg>
          <form class="sigil-form" data-sigil-form>
            <label class="sr-only" for="sigil-word">Your intention</label>
            <input id="sigil-word" maxlength="40" autocomplete="off" placeholder="Your intention, in a few words" />
            <button type="submit" class="btn btn-ghost btn-sm">Make my sigil</button>
          </form>
          <div class="sg-draw-controls" data-draw-controls>
            <button type="button" class="btn btn-ghost btn-sm" data-draw-clear>Clear</button>
            <button type="button" class="btn btn-ghost btn-sm" data-draw-seal>Seal it</button>
          </div>
          <p class="dv-sig-hint" data-sigil-hint aria-live="polite">Your sigil will be drawn here.</p>
          <button type="button" class="btn btn-ghost btn-sm" data-sigil-save hidden>Save it as a picture</button>
        </div>
      </div>
    </section>

    <!-- the seven chapters, on day and night pages -->
    {moves.map((m, i) => (
      <section class={`chapter mg-move mg-${m.page} mg-${m.key}`} id={anchor(m.category)} data-chapter={`magG_${m.key}`} data-mag-chapter={m.key}>
        <div class={`chapter-inner mg-inner${m.key === 'rituals' ? ' mg-with-wheel' : ''}`}>
          <header class="mg-head">
            <p class="kicker mg-kicker" data-fade><span class="mg-num">{ROMAN[i]}</span> · {categoryCount(m.cat)} services</p>
            <h2 class="display-l" data-split data-dust>{m.title}</h2>
            <p class="lede" data-fade>{m.line}</p>
            {m.key === 'protection' && (
              <p class="mg-keeper" data-fade>Hecate, honoured of old at crossroads and doorways, keeps watch over this chapter, and over the home and threshold work in it.</p>
            )}
            {m.key === 'baneful' && (
              <p class="mg-care" data-fade>Baneful work is considered case by case and may be declined. <a href="/care">Read Boundaries and care</a>.</p>
            )}
            <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={m.category}>Ask about this</a></div>
          </header>

          {m.key === 'rituals' && (
            <div class="wheel" data-wheel data-mode="sabbats" data-fade>
              <div class="wheel-modes" role="group" aria-label="Which wheel">
                <button type="button" data-wheel-mode="sabbats" aria-pressed="true">Wheel of the year</button>
                <button type="button" data-wheel-mode="ritus" aria-pressed="false">Indian seasons</button>
              </div>
              <svg viewBox="-150 -150 300 300" class="wheel-svg" tabindex="0" role="slider" aria-label="Turn the wheel" aria-valuemin="0" aria-valuemax="360" aria-valuenow="0">
                <g data-wheel-rot>
                  <circle r="128" class="wh-ring" /><circle r="98" class="wh-ring thin" /><circle r="60" class="wh-ring thin" />
                  <g class="wh-set" data-set="sabbats">
                    {SABBATS.map((s, k) => (
                      <g class="wh-sabbat" data-item={k}>
                        <line class="wh-spoke" x1="0" y1="-60" x2="0" y2="-128" />
                        <circle class="wh-dot" cy="-128" r="5" />
                        <text class="wh-label" y="-108" text-anchor="middle">{s.name}</text>
                      </g>
                    ))}
                  </g>
                  <g class="wh-set" data-set="ritus">
                    {RITUS.map((r, k) => (
                      <g class="wh-sabbat wh-ritu" data-item={k}>
                        <line class="wh-spoke" x1="0" y1="-60" x2="0" y2="-128" />
                        <text class="wh-label" y="-108" text-anchor="middle" data-mid>{r.name}</text>
                      </g>
                    ))}
                  </g>
                  <circle class="wh-today" data-wheel-today r="4" cy="-128" />
                </g>
                <path class="wh-pointer" d="M0 -146 L-7 -134 L7 -134 Z" />
                <g class="wh-moon" data-wheel-moon></g>
              </svg>
              <p class="wheel-now" data-wheel-now aria-live="polite"></p>
              <p class="dv-sig-hint" data-wheel-note>Drag to turn the wheel. The marker at the top is today.</p>
            </div>
          )}

          <SubCards category={m.cat} pillar={p.name} icons={SUB_ICON} />
        </div>
      </section>
    ))}

    <!-- night · the close, back at the crossroads -->
    <section class="chapter mg-close mg-night" data-chapter="magG_close" data-mag-chapter="close">
      <div class="chapter-inner narrow center">
        <p class="kicker" data-fade>When you are ready</p>
        <h2 class="display-l" data-split>Every spell begins with an intention</h2>
        <p class="lede" data-fade>Tell Sarvakali what you would like to change. Together you will find the right working.</p>
        <div class="cta-row center" data-fade>
          <a class="btn btn-solid" href="/connect" data-topic={p.name}>Request a conversation</a>
          <a class="btn btn-ghost" href="/path">Find your path</a>
        </div>
      </div>
    </section>

    <nav class="pp-nav" aria-label="Other pillars">
      <a href={`/pillars/${prev.slug}`}><span>Previous pillar</span><b transition:name={`pt-${prev.slug}`} data-pt>{prev.name}</b></a>
      <a href={`/pillars/${next.slug}`}><span>Next pillar</span><b transition:name={`pt-${next.slug}`} data-pt>{next.name}</b></a>
    </nav>
  </div>
</Base>
