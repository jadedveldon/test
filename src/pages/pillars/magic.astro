---
/**
 * Pillar 2, Witchcraft & Magic: seven chapters (the catalogue's seven
 * categories), in three directions to compare (A The grimoire, B Moon garden,
 * C Alchemical sky).
 */
import Base from '../../layouts/Base.astro';
import SubCards from '../../components/SubCards.astro';
import { pillars, categoryCount } from '../../data/site';
import { CHAPTERS, MAG_DIRECTIONS, RITUS, SABBATS, SUB_ICON } from '../../data/magic';

const index = pillars.findIndex((p) => p.slug === 'magic');
const p = pillars[index];
const prev = pillars[(index + pillars.length - 1) % pillars.length];
const next = pillars[(index + 1) % pillars.length];
const anchor = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII'];
const moves = CHAPTERS.map((ch) => ({ ...ch, cat: p.categories.find((c) => c.name === ch.category)! }));
const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const QUARTERS = [
  { name: 'East', el: 'Air', a: 0 }, { name: 'South', el: 'Fire', a: 90 }, { name: 'West', el: 'Water', a: 180 }, { name: 'North', el: 'Earth', a: 270 },
];
const pos = (deg: number, r: number) => { const a = (deg * Math.PI) / 180; return [Math.cos(a) * r, Math.sin(a) * r]; };
---
<Base title={`${p.name} · Sarvakali`} sequence="magA_hero" description={p.line}>
  <div class="mg" data-magic>
    <section class="chapter mg-hero" data-chapter="magA_hero" data-mag-chapter="hero">
      <div class="chapter-inner mg-hero-grid">
        <div class="mg-hero-copy">
          <a class="back-link" href="/#paths">← All pillars</a>
          <p class="kicker" data-hero>Pillar {index + 1} of {pillars.length} · {p.count} services</p>
          <h1 class="display-l mg-title" data-hero data-split transition:name="pt-magic" data-pt>{p.name}</h1>
          <p class="lede" data-hero>{p.line}</p>
          <ol class="mg-planets" data-hero aria-label="The seven chapters">
            {moves.map((m, i) => (
              <li>
                <a href={`#${anchor(m.category)}`}>
                  <span class="mg-glyph" aria-hidden="true">{ROMAN[i]}</span>
                  <span class="mg-pl-title">{m.title}</span>
                  <span class="mg-pl-day">{categoryCount(m.cat)} services</span>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <div class="mg-sig" data-hero>
          <!-- A · make a sigil -->
          <div class="sigil-maker" data-mag-only="a" data-sigil>
            <svg viewBox="-130 -130 260 260" class="sigil-svg" aria-hidden="true">
              <circle r="114" class="sg-ring" /><circle r="88" class="sg-ring thin" />
              {LETTERS.map((L, i) => { const [x, y] = pos(-90 + (i * 360) / 26, 101); return <text x={x.toFixed(1)} y={(y + 3.5).toFixed(1)} class="sg-letter" data-letter={L}>{L}</text>; })}
              <path class="sg-path" data-sigil-path d="" />
              <circle class="sg-start" data-sigil-start r="5" cx="0" cy="-900" />
              <line class="sg-end" data-sigil-end x1="0" y1="-900" x2="0" y2="-900" />
              <g class="sg-seal" data-sigil-seal transform="scale(0)">
                <circle r="30" class="sg-wax" /><circle r="22" class="sg-wax-ring" />
                <path class="sg-wax-mark" d="M0 -13 Q9 0 0 13 Q-9 0 0 -13Z" /><circle r="3.5" class="sg-wax-dot" />
              </g>
            </svg>
            <form class="sigil-form" data-sigil-form>
              <label class="sr-only" for="sigil-word">Your intention</label>
              <input id="sigil-word" maxlength="40" autocomplete="off" placeholder="Your intention, in a few words" />
              <button type="submit" class="btn btn-ghost btn-sm">Make my sigil</button>
            </form>
            <p class="dv-sig-hint" data-sigil-hint>One common modern method: vowels and repeated letters fall away, and the rest are joined on a letter wheel. Sarvakali may make sigils differently.</p>
          </div>

          <!-- B · the wheel of the year -->
          <div class="wheel" data-mag-only="b" data-wheel data-mode="sabbats">
            <div class="wheel-modes" role="group" aria-label="Which wheel">
              <button type="button" data-wheel-mode="sabbats" aria-pressed="true">Wheel of the year</button>
              <button type="button" data-wheel-mode="ritus" aria-pressed="false">Indian seasons (ritus)</button>
            </div>
            <svg viewBox="-150 -150 300 300" class="wheel-svg" tabindex="0" role="slider" aria-label="Turn the wheel" aria-valuemin="0" aria-valuemax="360" aria-valuenow="0">
              <g data-wheel-rot>
                <circle r="128" class="wh-ring" /><circle r="98" class="wh-ring thin" /><circle r="60" class="wh-ring thin" />
                <g class="wh-set" data-set="sabbats">
                  {SABBATS.map((s, i) => (
                    <g class="wh-sabbat" data-item={i}>
                      <line class="wh-spoke" x1="0" y1="-60" x2="0" y2="-128" />
                      <circle class="wh-dot" cy="-128" r="5" />
                      <text class="wh-label" y="-108" text-anchor="middle">{s.name}</text>
                    </g>
                  ))}
                </g>
                <g class="wh-set" data-set="ritus">
                  {RITUS.map((r, i) => (
                    <g class="wh-sabbat wh-ritu" data-item={i}>
                      <line class="wh-spoke" x1="0" y1="-60" x2="0" y2="-128" />
                      <text class="wh-label" y="-108" text-anchor="middle" data-mid>{r.name}</text>
                    </g>
                  ))}
                </g>
                <circle class="wh-today" data-wheel-today r="4" cy="-128" />
              </g>
              <path class="wh-pointer" d="M0 -146 L-7 -134 L7 -134 Z" />
              <g class="wh-moon" data-wheel-moon></g>
            </svg>
            <p class="wheel-now" data-wheel-now aria-live="polite"></p>
            <p class="dv-sig-hint" data-wheel-note>Drag to turn the wheel. The marker at the top is today. The modern pagan wheel, northern hemisphere.</p>
          </div>

          <!-- C · cast a circle -->
          <div class="circle-cast" data-mag-only="c" data-cast>
            <svg viewBox="-150 -150 300 300" class="cast-svg" aria-hidden="true">
              <circle r="110" class="cast-guide" />
              <path class="cast-trace" data-cast-trace d="" />
              <g class="cast-star"><path d={(() => { const pts = [0, 1, 2, 3, 4].map((k) => pos(-90 + k * 144, 52)); return `M${pts.map((q) => q.map((v) => v.toFixed(1)).join(' ')).join(' L')} Z`; })()} /><circle r="56" /></g>
              {QUARTERS.map((q) => { const [x, y] = pos(q.a, 110); const [lx, ly] = pos(q.a, 138); return (
                <g class="cast-q" data-quarter={q.a}>
                  <rect x={(x - 5).toFixed(1)} y={(y - 2).toFixed(1)} width="10" height="16" rx="1.5" class="cast-candle" />
                  <path class="cast-flame" d={`M${x.toFixed(1)} ${(y - 3).toFixed(1)} c-4 -5 -3 -10 0 -15 c3 5 4 10 0 15z`} />
                  <text x={lx.toFixed(1)} y={(ly + 4).toFixed(1)} text-anchor="middle" class="cast-label">{q.name}</text>
                </g>
              ); })}
            </svg>
            <p class="dv-sig-hint" data-cast-hint>Trace a circle around the star, going sunwise (clockwise)</p>
            <p class="dv-sig-hint small">Quarters as in many Wiccan circles: East air, South fire, West water, North earth. Traditions differ.</p>
            <button type="button" class="btn btn-ghost btn-sm" data-cast-auto>Cast it for me</button>
          </div>
        </div>
      </div>
    </section>

    {moves.map((m, i) => (
      <section class={`chapter mg-move mg-${m.key}`} id={anchor(m.category)} data-chapter={`magA_${m.key}`} data-mag-chapter={m.key}>
        <div class="chapter-inner mg-inner">
          <header class="mg-head">
            <p class="kicker mg-kicker" data-fade>{ROMAN[i]} · {categoryCount(m.cat)} services</p>
            <h2 class="display-l" data-split data-dust>{m.title}</h2>
            <p class="lede" data-fade>{m.line}</p>
            {m.key === 'baneful' && (
              <p class="mg-care" data-fade>Baneful work is considered case by case and may be declined. <a href="/care">Read Boundaries and care</a>.</p>
            )}
            <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={m.category}>Ask about this</a></div>
          </header>
          <SubCards category={m.cat} pillar={p.name} icons={SUB_ICON} />
        </div>
      </section>
    ))}

    <section class="chapter mg-close" data-chapter="magA_close" data-mag-chapter="close">
      <div class="chapter-inner narrow center">
        <p class="kicker" data-fade>When you are ready</p>
        <h2 class="display-l" data-split>Every spell begins with an intention</h2>
        <p class="lede" data-fade>Tell Sarvakali what you would like to change. Together you will find the right working.</p>
        <div class="cta-row center" data-fade>
          <a class="btn btn-solid" href="/connect" data-topic={p.name}>Request a conversation</a>
          <a class="btn btn-ghost" href="/path">Find your path</a>
        </div>
      </div>
    </section>

    <section class="dv-brief" aria-labelledby="mg-brief-title">
      <p class="kicker">Design exploration · this pillar</p>
      <h2 id="mg-brief-title" class="display-m">Three directions for Witchcraft &amp; Magic</h2>
      <p class="hint">All three share the same seven chapters. Switch between them with the buttons at the bottom of the screen: the page, the homepage chapter, the worlds, the type and the sound all change.</p>
      <div class="dv-briefs">
        {MAG_DIRECTIONS.map((d) => (
          <article class="dv-card" data-mag-card={d.key}>
            <header><span class="dv-card-key">{d.key.toUpperCase()}</span><h3>{d.name}</h3></header>
            <p class="dv-card-essence">{d.essence}</p>
            <ul class="dv-swatches" aria-label="Colours">{d.palette.map((c) => <li style={`--c:${c.hex}`}><span></span>{c.name}<small>{c.hex}</small></li>)}</ul>
            <dl>
              <div><dt>Feeling</dt><dd>{d.feeling.join(' · ')}</dd></div>
              <div><dt>Type</dt><dd>{d.type.display}, {d.type.note}</dd></div>
              <div><dt>Worlds</dt><dd>{d.worlds}</dd></div>
              <div><dt>Layout</dt><dd>{d.layout}</dd></div>
              <div><dt>Signature</dt><dd><b>{d.signature.name}.</b> {d.signature.how}</dd></div>
              <div><dt>Sound</dt><dd>{d.sound}</dd></div>
              <div><dt>Art needed</dt><dd>{d.imagery}</dd></div>
              <div><dt>Voice</dt><dd>{d.voice}</dd></div>
            </dl>
            <button type="button" class="btn btn-ghost btn-sm" data-mag-set={d.key}>See direction {d.key.toUpperCase()}</button>
          </article>
        ))}
      </div>
    </section>

    <nav class="pp-nav" aria-label="Other pillars">
      <a href={`/pillars/${prev.slug}`}><span>Previous pillar</span><b transition:name={`pt-${prev.slug}`} data-pt>{prev.name}</b></a>
      <a href={`/pillars/${next.slug}`}><span>Next pillar</span><b transition:name={`pt-${next.slug}`} data-pt>{next.name}</b></a>
    </nav>

    <div class="dv-switch" role="group" aria-label="Design direction">
      <span>Direction</span>
      {MAG_DIRECTIONS.map((d) => <button type="button" data-mag-set={d.key} aria-pressed="false" aria-label={`Direction ${d.key.toUpperCase()}: ${d.name}`}><b>{d.key.toUpperCase()}</b><span> · {d.name}</span></button>)}
    </div>
  </div>
</Base>
