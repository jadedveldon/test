---
/**
 * Pillar 2, Witchcraft & Magic · the gilded grimoire.
 * One book with two kinds of page: bright parchment day pages (the grimoire)
 * and black-and-emerald night pages in gold (the alchemical sky). Between them
 * the night spreads in like ink. Hecate, one of Sarvakali's presiding deities,
 * opens the pillar with her key (see src/data/hecate-key.ts); then a
 * sigil, then the seven chapters
 * (the catalogue's seven categories).
 */
import { pillarService } from '../../seo/ld';
import Base from '../../layouts/Base.astro';
import { crumbWords as cw } from '../../config';
import { words } from '../../config';
import SubCards from '../../components/SubCards.astro';
import { pillars, categoryCount } from '../../data/site';
import { CHAPTER_KEYS, CHAPTERS, COPY, HECATE, RITUS, SABBATS, SATURN, SIGIL_METHODS } from '../../data/magic';
import { categoryAliases, gather } from '../../data/chapters';
import Rich from '../../components/Rich.astro';
import HecateMark from '../../components/HecateMark.astro';

const index = pillars.findIndex((p) => p.slug === 'magic');
const p = pillars[index];
const prev = pillars[(index + pillars.length - 1) % pillars.length];
const next = pillars[(index + 1) % pillars.length];
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII'];
const moves = CHAPTERS.map((ch) => ({ ...ch, cat: gather(p, ch.key, ch.title, CHAPTER_KEYS) }));
const aliases = categoryAliases(p, CHAPTER_KEYS, Object.fromEntries(CHAPTERS.map((c) => [c.key, c.id])));
const sg = COPY.sigil, hk = COPY.hecate;
const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const pos = (deg: number, r: number) => { const a = (deg * Math.PI) / 180; return [Math.cos(a) * r, Math.sin(a) * r]; };

// Hecate's workings live in the Devotion catalogue (Greek deities); they are gathered here too
const devotion = pillars.find((x) => x.slug === 'devotion')!;
const hkName = hk.name.trim() || 'Hecate';
const escape = (t: string) => t.replace(/[.*+?^$()|[\]\\{}]/g, '\\$&');
const named = new RegExp(`(^|[^A-Za-z])${escape(hkName)}([^A-Za-z]|$)`);
const hecateWork = devotion.categories.flatMap((c) => c.subs).flatMap((s) => s.items).filter((it) => named.test(it));

---
<Base title={`${p.name} · Sarvakali`} sequence="magG_hero" description={p.line} crumbs={[{ label: cw.pillars, href: '/#paths' }, { label: p.name }]} ld={[pillarService(p)]}>
  <div class="mg" data-magic data-blend="edge">

    <!-- night · the opening, under Hecate's sign -->
    <section class="chapter mg-hero mg-night" data-chapter="magG_hero" data-mag-chapter="hero">
      <div class="chapter-inner mg-hero-grid">
        <div class="mg-hero-copy">
          <p class="kicker" data-hero>Pillar {index + 1} of {pillars.length} · {p.count} services</p>
          <h1 class="display-l mg-title" data-hero data-split transition:name="pt-magic" data-pt>{p.name}</h1>
          <p class="lede" data-hero>{p.line}</p>
          <a class="mg-presides" href="#hecate" data-hero>
            <svg viewBox="-40 -40 80 80" aria-hidden="true"><circle r="36" class="mp-ring" /><HecateMark x={-27} y={-27} size={54} /></svg>
            <span><small>{COPY.presides.small}</small> {COPY.presides.name}</span>
          </a>
          <ol class="mg-index" data-hero aria-label="The chapters of this book">
            <li class="is-night"><a href="#hecate"><span class="mg-num" aria-hidden="true">✦</span><span class="mg-ix-title">{COPY.index.hecate}</span></a></li>
            <li class="is-day"><a href="#make-a-sigil"><span class="mg-num" aria-hidden="true">✦</span><span class="mg-ix-title">{COPY.index.sigil}</span></a></li>
            {moves.map((m, i) => (
              <li class={`is-${m.page}`}>
                <a href={`#${m.id}`}>
                  <span class="mg-num" aria-hidden="true">{ROMAN[i]}</span>
                  <span class="mg-ix-title">{m.title}</span>
                  <span class="mg-ix-n">{categoryCount(m.cat)} services</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- night · Hecate -->
    <section class="chapter mg-move mg-night mg-hecate" id="hecate" data-chapter="magG_hecate" data-mag-chapter="hecate">
      <div class="chapter-inner mg-inner">
        <header class="mg-head">
          <p class="kicker" data-fade>{hk.kicker}</p>
          <h2 class="display-l hk-name" data-split data-dust>{hk.name}</h2>
          <p class="hk-greek" lang="grc" data-fade>{hk.greek}</p>
        </header>

        <figure class="hk-words" data-fade>
          <blockquote>
            {HECATE.words.map((w) => <p>{w}</p>)}
          </blockquote>
          <figcaption>
            <p>{HECATE.wordsLine}</p>
            <p class="hk-draft">{hk.wordsNote}</p>
          </figcaption>
        </figure>

        <div class="hk-supper" data-supper data-fade>
          <svg class="hk-moon" viewBox="-60 -60 120 120" aria-hidden="true">
            <circle r="44" class="hk-moon-disc" /><circle r="44" class="hk-moon-rim" /><circle r="54" class="hk-moon-halo" />
          </svg>
          <div class="hk-supper-copy">
            <h3>{HECATE.supper.title}</h3>
            <p>{HECATE.supper.text}</p>
            <p class="hk-when">{hk.supper.when} <span data-supper-when>shown when the page has loaded</span></p>
            <div class="cta-row">
              <button type="button" class="btn btn-ghost btn-sm" data-supper-cal>{hk.supper.calendar}</button>
              <a class="btn btn-ghost btn-sm" href="/connect" data-topic="A working on the dark moon">{hk.supper.ask}</a>
            </div>
            <p class="hk-note"><Rich text={HECATE.supper.note} /> {HECATE.supper.href.startsWith('https://') && <a href={HECATE.supper.href} target="_blank" rel="noopener">{hk.supper.linkText}</a>}</p>
          </div>
        </div>

        <div class="hk-work" data-fade>
          <p class="kicker">{hk.workKicker} · {hecateWork.length}</p>
          <ul class="sub-chips">
            {hecateWork.map((it) => <li><button type="button" class="chip-keep" data-keep={it} data-keep-p={devotion.name} aria-pressed="false">{it === hkName ? `${hkName} working` : it}</button></li>)}
          </ul>
          <p class="hk-also"><Rich text={hk.also} /></p>
        </div>
      </div>
    </section>

    <!-- day · make a sigil, five ways -->
    <section class="chapter mg-move mg-day mg-sigil-sec" id="make-a-sigil" data-chapter="magG_sigil" data-mag-chapter="sigil">
      <div class="chapter-inner mg-sigil-grid">
        <header class="mg-head">
          <p class="kicker" data-fade>{sg.kicker}</p>
          <h2 class="display-l" data-split data-dust>{sg.title}</h2>
          <p class="lede" data-fade>{sg.lede}</p>
          <div class="sg-methods" role="group" aria-label="Ways of making a sigil" data-fade>
            {SIGIL_METHODS.map((m, i) => <button type="button" data-sigil-method={m.key} aria-pressed={i === 0 ? 'true' : 'false'}>{m.name}</button>)}
          </div>
          <div class="sg-method-note" data-fade aria-live="polite">
            <p class="sg-how" data-sigil-how>{SIGIL_METHODS[0].how}</p>
            <p class="sg-origin" data-sigil-origin>{SIGIL_METHODS[0].origin}</p>
          </div>
          <p class="hk-note" data-fade>{sg.note}</p>
        </header>
        <div class="sigil-maker" data-sigil data-method={SIGIL_METHODS[0].key} data-arr="line" data-fade>
          <svg viewBox="-130 -130 260 260" class="sigil-svg" data-sigil-svg aria-label="Your sigil" role="img">
            <circle r="122" class="sg-gild" /><circle r="114" class="sg-ring" />
            {Array.from({ length: 52 }, (_, k) => { const [x1, y1] = pos(k * (360 / 52), 114); const [x2, y2] = pos(k * (360 / 52), k % 2 ? 118 : 121); return <line x1={x1.toFixed(1)} y1={y1.toFixed(1)} x2={x2.toFixed(1)} y2={y2.toFixed(1)} class="sg-tick" />; })}
            <g class="sg-board" data-board="wheel">
              <circle r="88" class="sg-ring thin" />
              {LETTERS.map((L, i) => { const [x, y] = pos(-90 + (i * 360) / 26, 101); return <text x={x.toFixed(1)} y={(y + 3.5).toFixed(1)} class="sg-letter" data-letter={L}>{L}</text>; })}
            </g>
            <g class="sg-board" data-board="square">
              <rect x="-78" y="-78" width="156" height="156" class="sg-cell" />
              <path d="M-26 -78V78M26 -78V78M-78 -26H78M-78 26H78" class="sg-cell" />
              {SATURN.map((row, r) => row.map((n, c) => <text x={(c - 1) * 52 + 16} y={(r - 1) * 52 + 21} class="sg-num" data-num={n}>{n}</text>))}
            </g>
            <g class="sg-board" data-board="draw"><circle r="88" class="sg-ring thin" /></g>
            <g class="sg-mark" data-sigil-mark></g>
          </svg>
          <form class="sigil-form" data-sigil-form>
            <label class="sr-only" for="sigil-word">Your intention</label>
            <input id="sigil-word" maxlength="40" autocomplete="off" placeholder={sg.placeholder} />
            <button type="submit" class="btn btn-ghost btn-sm">{sg.make}</button>
          </form>
          <div class="sg-mono-tools" role="group" aria-label="Arrange the monogram">
            <div class="sg-arr">
              <span>{sg.arrange}</span>
              <button type="button" data-mono-arr="line" aria-pressed="true">{sg.line}</button>
              <button type="button" data-mono-arr="ring" aria-pressed="false">{sg.ring}</button>
              <button type="button" data-mono-arr="stack" aria-pressed="false">{sg.stack}</button>
            </div>
            <div class="sg-arr">
              <span>{sg.picked}</span>
              <button type="button" data-mono-turn disabled>{sg.turn}</button>
              <button type="button" data-mono-flip disabled>{sg.flip}</button>
            </div>
          </div>
          <div class="sg-tools">
            <button type="button" class="btn btn-ghost btn-sm" data-sigil-pen aria-pressed="false" hidden>{sg.pen}</button>
            <button type="button" class="btn btn-ghost btn-sm sg-clear" data-draw-clear>{sg.clear}</button>
            <button type="button" class="btn btn-ghost btn-sm" data-sigil-save hidden>{sg.save}</button>
          </div>
          <p class="dv-sig-hint" data-sigil-hint aria-live="polite">{sg.hint}</p>
        </div>
      </div>
    </section>

    <!-- the seven chapters, on day and night pages -->
    {moves.map((m, i) => (
      <section class={`chapter mg-move mg-${m.page} mg-${m.key}`} id={m.id} data-chapter={`magG_${m.key}`} data-mag-chapter={m.key}>
        {(aliases[m.key] || []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
        <div class={`chapter-inner mg-inner${m.key === 'rituals' ? ' mg-with-wheel' : ''}`}>
          <header class="mg-head">
            <p class="kicker mg-kicker" data-fade><span class="mg-num">{ROMAN[i]}</span> · {categoryCount(m.cat)} services</p>
            <h2 class="display-l" data-split data-dust>{m.title}</h2>
            <p class="lede" data-fade>{m.line}</p>
            {m.key === 'protection' && (
              <p class="mg-keeper" data-fade><Rich text={COPY.protectionKeeper} /></p>
            )}
            {m.key === 'baneful' && (
              <p class="mg-care" data-fade><Rich text={COPY.banefulCare} /></p>
            )}
            <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={m.title}>{words.ask}</a></div>
          </header>

          {m.key === 'rituals' && (
            <div class="wheel" data-wheel data-mode="sabbats" data-fade>
              <div class="wheel-modes" role="group" aria-label="Which wheel">
                <button type="button" data-wheel-mode="sabbats" aria-pressed="true">{COPY.wheel.sabbatsLabel}</button>
                <button type="button" data-wheel-mode="ritus" aria-pressed="false">{COPY.wheel.ritusLabel}</button>
              </div>
              <svg viewBox="-150 -150 300 300" class="wheel-svg" tabindex="0" role="slider" aria-label="Turn the wheel" aria-valuemin="0" aria-valuemax="360" aria-valuenow="0">
                <g data-wheel-rot>
                  <circle r="128" class="wh-ring" /><circle r="98" class="wh-ring thin" /><circle r="60" class="wh-ring thin" />
                  <g class="wh-set" data-set="sabbats">
                    {SABBATS.map((s, k) => (
                      <g class="wh-sabbat" data-item={k}>
                        <line class="wh-spoke" x1="0" y1="-60" x2="0" y2="-128" />
                        <circle class="wh-dot" cy="-128" r="5" />
                        <text class="wh-label" y="-108" text-anchor="middle">{s.name}</text>
                      </g>
                    ))}
                  </g>
                  <g class="wh-set" data-set="ritus">
                    {RITUS.map((r, k) => (
                      <g class="wh-sabbat wh-ritu" data-item={k}>
                        <line class="wh-spoke" x1="0" y1="-60" x2="0" y2="-128" />
                        <text class="wh-label" y="-108" text-anchor="middle" data-mid>{r.name}</text>
                      </g>
                    ))}
                  </g>
                  <circle class="wh-today" data-wheel-today r="4" cy="-128" />
                </g>
                <path class="wh-pointer" d="M0 -146 L-7 -134 L7 -134 Z" />
                <g class="wh-moon" data-wheel-moon></g>
              </svg>
              <p class="wheel-now" data-wheel-now aria-live="polite"></p>
              <p class="dv-sig-hint" data-wheel-note>{COPY.wheel.hint}</p>
            </div>
          )}

          <SubCards category={m.cat} pillar={p.name} />
        </div>
      </section>
    ))}

    <!-- night · the close, under Hecate's sign again -->
    <section class="chapter mg-close mg-night" data-chapter="magG_close" data-mag-chapter="close">
      <div class="chapter-inner narrow center">
        <p class="kicker" data-fade>{COPY.close.kicker}</p>
        <h2 class="display-l" data-split>{COPY.close.title}</h2>
        <p class="lede" data-fade>{COPY.close.lede}</p>
        <div class="cta-row center" data-fade>
          <a class="btn btn-solid" href="/connect" data-topic={p.name}>{COPY.close.button}</a>
          <a class="btn btn-ghost" href="/path">{words.path}</a>
        </div>
      </div>
    </section>

    <nav class="pp-nav" aria-label="Other pillars">
      <a href={`/pillars/${prev.slug}`}><span>{words.previous}</span><b transition:name={`pt-${prev.slug}`} data-pt>{prev.name}</b></a>
      <a href={`/pillars/${next.slug}`}><span>{words.next}</span><b transition:name={`pt-${next.slug}`} data-pt>{next.name}</b></a>
    </nav>
  </div>
</Base>
