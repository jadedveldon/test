---
/**
 * Pillar 6, Learning: the library, the leaf and the stars. The page walks through three rooms: the library by
 * lamplight (direction A), the palm-leaf manuscripts (direction C) and the night road of study (direction B).
 * Find your class sits in the library; Your path opens the sky. The yantra drawing is in the project history.
 */
import { pillarService } from '../../seo/ld';
import Base from '../../layouts/Base.astro';
import { crumbWords as cw } from '../../config';
import { words } from '../../config';
import SubCards from '../../components/SubCards.astro';
import { pillars, categoryCount } from '../../data/site';
import { categoryAliases, gather } from '../../data/chapters';
import { CHAPTER_KEYS, CHAPTERS, COPY, FINDER, FORMATS, SIDE_FROM, STATION_XY, STATIONS } from '../../data/learning';
import Rich from '../../components/Rich.astro';

const index = pillars.findIndex((p) => p.slug === 'learning');
const p = pillars[index];
const prev = pillars[(index + pillars.length - 1) % pillars.length];
const next = pillars[(index + 1) % pillars.length];
const ROMAN = ['I', 'II', 'III', 'IV', 'V'];
const ROOM: Record<string, string> = COPY.rooms;
const moves = CHAPTERS.map((ch, i) => ({ ...ch, cat: gather(p, ch.key, ch.title, CHAPTER_KEYS), id: ch.key, n: ROMAN[i] }));
const aliases = categoryAliases(p, CHAPTER_KEYS, Object.fromEntries(moves.map((m) => [m.key, m.id])));
const fd = COPY.finder, pa = COPY.path;
const road = STATION_XY.slice(0, 9).map(([x, y]) => `${x} ${y}`).join(' L');
/* the road under the stars comes just before mentoring */
const beforeSky = moves.filter((m) => m.room !== 'sky');
const sky = moves.filter((m) => m.room === 'sky');
---
<Base title={`${p.name} · Sarvakali`} sequence="lrn_hero" description={p.line} crumbs={[{ label: cw.pillars, href: '/#paths' }, { label: p.name }]} ld={[pillarService(p)]}>
  <div class="pd pd-learning" data-learning data-blend="edge">
    <section class="chapter pd-hero ln-library" data-chapter="lrn_hero">
      <div class="chapter-inner pd-hero-grid">
        <div class="pd-hero-copy">
          <p class="kicker" data-hero>Pillar {index + 1} of {pillars.length} · {p.count} classes and services</p>
          <h1 class="display-l pd-title" data-hero data-split transition:name="pt-learning" data-pt>{p.name}</h1>
          <p class="lede" data-hero>{p.line}</p>
          <div class="ln-formats" data-hero>
            <p class="kicker">{COPY.formats.kicker}</p>
            <ul>{FORMATS.map((f) => <li><button type="button" class="chip-keep" data-keep={f} data-keep-p={p.name} aria-pressed="false">{f}</button></li>)}</ul>
          </div>
          <ol class="pd-index" data-hero aria-label="The chapters">
            {moves.map((m) => <li class={`ln-ix-${m.room}`}><a href={`#${m.id}`}><span class="pd-num" aria-hidden="true">{m.n}</span><span class="pd-ix-title">{m.title}</span><span class="pd-ix-n">{categoryCount(m.cat)} {categoryCount(m.cat) === 1 ? 'class' : 'classes and services'}</span></a></li>)}
          </ol>
        </div>

        <div class="pd-sig" data-hero>
          <!-- find your class, at the library table -->
          <form class="finder" id="class-finder" data-finder>
            <p class="kicker">{fd.kicker}</p>
            {FINDER.map((f, qi) => (
              <fieldset data-finder-q={qi}>
                <legend><span>{qi + 1}</span> {f.q}</legend>
                <div class="fd-opts">{f.a.map((a, ai) => <label><input type="radio" name={`fd-${qi}`} value={ai} /><span>{a.label}</span></label>)}</div>
              </fieldset>
            ))}
            <div class="fd-result" data-finder-result hidden>
              <p class="kicker">{fd.result}</p>
              <ul data-finder-list></ul>
              <a class="btn btn-ghost btn-sm" href="/connect" data-topic={p.name}>{fd.ask}</a>
            </div>
            <p class="small fd-more"><Rich text={fd.more} /></p>
          </form>
        </div>
      </div>
    </section>

    {beforeSky.map((m) => (
      <section class={`chapter pd-move ln-${m.key} ln-${m.room}`} id={m.id} data-chapter={`lrn_${m.key}`}>
        {(aliases[m.key] || []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
        <div class="chapter-inner pd-inner">
          <header class="pd-head">
            <p class="kicker" data-fade><span class="pd-num">{m.n}</span> · {categoryCount(m.cat)} {categoryCount(m.cat) === 1 ? 'class' : 'classes and services'} · {ROOM[m.room!]}</p>
            <h2 class="display-l" data-split data-dust>{m.title}</h2>
            <p class="lede" data-fade>{m.line}</p>
            {m.note && <p class="pd-note" data-fade><Rich text={m.note} /></p>}
            <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={m.title}>{words.ask}</a></div>
          </header>
          <SubCards category={m.cat} pillar={p.name} show={6} />
        </div>
      </section>
    ))}

    <!-- your path: out under the stars, the whole road of study -->
    <section class="chapter pd-move ln-path ln-sky" id="your-path" data-chapter="lrn_path">
      <div class="chapter-inner pd-inner pd-split">
        <header class="pd-head">
          <p class="kicker" data-fade>{ROOM.sky}</p>
          <h2 class="display-l" data-split>{pa.title}</h2>
          <p class="lede" data-fade>{pa.lede}</p>
          <p class="pd-note" data-fade>{pa.note}</p>
        </header>
        <div class="pathmap" data-studypath data-fade>
          <svg viewBox="-160 -130 320 260" class="pm-svg">
            <path d={`M${road}`} class="pm-road" />
            {SIDE_FROM.map((from, k) => <path d={`M${STATION_XY[from][0]} ${STATION_XY[from][1]} L${STATION_XY[9 + k][0]} ${STATION_XY[9 + k][1]}`} class="pm-road side" />)}
            {STATIONS.map((s, i) => (
              <g class={`pm-station${i === 8 ? ' is-end' : ''}${i > 8 ? ' is-side' : ''}`} data-station={i} transform={`translate(${STATION_XY[i][0]} ${STATION_XY[i][1]})`} tabindex="0" role="button" aria-label={s.name}>
                <circle r="14" class="pm-hit" /><circle r={i === 8 ? 7 : 4.5} class="pm-star" />
              </g>
            ))}
            <text x="-130" y="118" class="pm-cap">{pa.begin}</text><text x="128" y="-104" class="pm-cap" text-anchor="end">{pa.end}</text>
          </svg>
          <div class="pm-card" aria-live="polite">
            <p class="kicker" data-station-ch>{STATIONS[0].ch}</p>
            <h3 data-station-name>{STATIONS[0].name}</h3>
            <p data-station-line>{STATIONS[0].line}</p>
            <button type="button" class="chip-keep" data-station-keep data-keep={STATIONS[0].name} data-keep-p={p.name} aria-pressed="false">{pa.keep}</button>
          </div>
        </div>
      </div>
    </section>

    {sky.map((m) => (
      <section class={`chapter pd-move ln-${m.key} ln-${m.room}`} id={m.id} data-chapter={`lrn_${m.key}`}>
        {(aliases[m.key] || []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
        <div class="chapter-inner pd-inner">
          <header class="pd-head">
            <p class="kicker" data-fade><span class="pd-num">{m.n}</span> · {categoryCount(m.cat)} {categoryCount(m.cat) === 1 ? 'class' : 'classes and services'} · {ROOM[m.room!]}</p>
            <h2 class="display-l" data-split data-dust>{m.title}</h2>
            <p class="lede" data-fade>{m.line}</p>
            {m.note && <p class="pd-note" data-fade><Rich text={m.note} /></p>}
            <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={m.title}>{words.ask}</a></div>
          </header>
          <SubCards category={m.cat} pillar={p.name} show={6} />
        </div>
      </section>
    ))}

    <section class="chapter pd-close ln-sky" data-chapter="lrn_close">
      <div class="chapter-inner narrow center">
        <p class="kicker" data-fade>{COPY.close.kicker}</p>
        <h2 class="display-l" data-split>{COPY.close.title}</h2>
        <p class="lede" data-fade>{COPY.close.lede}</p>
        <div class="cta-row center" data-fade>
          <a class="btn btn-solid" href="/connect" data-topic={p.name}>{COPY.close.button}</a>
          <a class="btn btn-ghost" href="/path">{words.path}</a>
        </div>
      </div>
    </section>

    <nav class="pp-nav" aria-label="Other pillars">
      <a href={`/pillars/${prev.slug}`}><span>{words.previous}</span><b transition:name={`pt-${prev.slug}`} data-pt>{prev.name}</b></a>
      <a href={`/pillars/${next.slug}`}><span>{words.next}</span><b transition:name={`pt-${next.slug}`} data-pt>{next.name}</b></a>
    </nav>
  </div>
</Base>
