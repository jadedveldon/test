---
/**
 * Pillar 1, Devotion & the Unseen · direction C, Cosmic mother.
 * Each tradition is its own movement with its own world behind it:
 *   Kali and the Mahavidyas, the Devi and the Hindu deities (the yantra),
 *   the Greek gods (the temple and the five elements), many lands (the stars),
 *   altars and devotion (lamps), spirits and ancestors (a nebula),
 *   shamanic work (the world tree).
 */
import { pillarService } from '../../seo/ld';
import { words as SW } from '../../config';
import Base from '../../layouts/Base.astro';
import { crumbWords as cw } from '../../config';
import { words } from '../../config';
import Yantra from '../../components/Yantra.astro';
import { lotus, lineD } from '../../data/kali-yantra';
import PillarSubs from '../../components/PillarSubs.astro';
import { pillars, categoryCount } from '../../data/site';
import { CHAPTER_KEYS, COPY, ELEMENTS, FAMILIES, GREEK, HINDU, HINDU_ALSO, LANDS, MAHAVIDYAS, MOVES, TANTRA } from '../../data/devotion';
import { categoryAliases, categoryOf, gather } from '../../data/chapters';
import Rich from '../../components/Rich.astro';

const index = pillars.findIndex((p) => p.slug === 'devotion');
const p = pillars[index];
const prev = pillars[(index + pillars.length - 1) % pillars.length];
const next = pillars[(index + 1) % pillars.length];
// each catalogue subcategory names the movement it sits in
const ch = Object.fromEntries(CHAPTER_KEYS.map((k) => [k, gather(p, k, COPY.chapters[k].title, CHAPTER_KEYS)]));
const mv = COPY.chapters;
const catName = (k: string) => categoryOf(p, k, CHAPTER_KEYS)?.name ?? '';
const aliases = categoryAliases(p, CHAPTER_KEYS, Object.fromEntries(MOVES));
const itemsOf = (k: string) => ch[k].subs.flatMap((s) => s.items);
// a service added in the editor to a movement drawn by hand (the Mahavidyas, the Devi, many lands) still shows
const left = (k: string, shown: string[]) => itemsOf(k).filter((it) => !shown.includes(it));
const more = {
  vidyas: left('vidyas', [...MAHAVIDYAS.map((v) => v.service), COPY.allTen.service]),
  devi: left('devi', [...HINDU.map((d) => d.service), ...HINDU_ALSO, ...TANTRA]),
  lands: left('lands', LANDS.flatMap((l) => l.names)),
};
const greekItems = itemsOf('greek');

// each Greek god with the workings that name them; the rest form the pantheon list
const hasName = (item: string, name: string) => new RegExp(`(^|[^A-Za-z])${name}([^A-Za-z]|$)`).test(item);
const greekCards = GREEK.map((g) => ({ ...g, items: greekItems.filter((it) => hasName(it, g.name)) }));
const pantheon = greekItems.filter((it) => GREEK.filter((g) => hasName(it, g.name)).length !== 1);
const short = (s: string) => s.replace(/ Devotional (Working|Study)$/, '').replace(/-Inspired$/, '');

const tri = (r: number) => [90, 210, 330].map((d) => { const a = (d * Math.PI) / 180; return `${(Math.cos(a) * r).toFixed(1)} ${(Math.sin(a) * r).toFixed(1)}`; });
const triPath = (r: number) => { const t = tri(r); return `M${t[0]} L${t[1]} L${t[2]} Z`; };
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII'];
const alias = (k: string) => (aliases[k] || []);
---
<Base title={`${p.name} · Sarvakali`} sequence="devC_hero" description={p.line} crumbs={[{ label: cw.pillars, href: '/#paths' }, { label: p.name }]} ld={[pillarService(p)]}>
  <Yantra />
  <div class="dv" data-devotion>
    <section class="chapter dv-hero" data-chapter="devC_hero" data-dev-chapter="hero">
      <div class="chapter-inner dv-hero-grid">
        <div class="dv-hero-copy">
          <p class="kicker" data-hero>Pillar {index + 1} of {pillars.length} · {p.count} services</p>
          <h1 class="display-l dv-title" data-hero data-split transition:name="pt-devotion" data-pt>{p.name}</h1>
          <p class="lede" data-hero>{p.line}</p>
          <ol class="dv-moves" data-hero aria-label={SW.inThisPillar}>
            {MOVES.map(([k, id], i) => <li><a href={`#${id}`}><span>{ROMAN[i]}</span>{mv[k].menu}</a></li>)}
          </ol>
        </div>
        <div class="dv-sig" data-hero>
          <div class="yantra-turn" data-yantra>
            <svg viewBox="-150 -150 300 300" class="yt-svg" tabindex="0" role="slider" aria-label={SW.turnYantra} aria-valuemin="0" aria-valuemax="360" aria-valuenow="47">
              <!-- a mala of 108 beads round the yantra, drawn in the same figure so it always shares its centre -->
              <g class="yt-mala" aria-hidden="true">{Array.from({ length: 108 }, (_, i) => { const a = (i / 108) * Math.PI * 2 - Math.PI / 2; return <circle cx={(Math.cos(a) * 143).toFixed(1)} cy={(Math.sin(a) * 143).toFixed(1)} r={i === 0 ? 3.4 : 1.6} class={i === 0 ? 'yt-bead meru' : 'yt-bead'} />; })}</g>
              <g class="yt-rot" data-yt-rot>
                <circle r="132" class="yt-line" />
                {lotus(96, 132).map((l) => <path class="yt-line" d={lineD(l)} />)}
                <circle r="96" class="yt-line" />
                <circle r="90" class="yt-line thin" />
                {[28, 44, 60, 76].map((r) => <path class="yt-line" d={triPath(r)} />)}
              </g>
              <g>{[36, 52, 68].map((r) => <path class="yt-line ghost" d={triPath(r)} transform="rotate(180)" />)}</g>
              <circle r="5" class="yt-bindu" />
            </svg>
            <ul class="yt-names" aria-hidden="true">{MAHAVIDYAS.map((v, i) => <li style={`--i:${i}`}>{v.name}</li>)}</ul>
            <p class="dv-sig-hint" data-yt-hint>{COPY.yantraHint}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- I · Kali and the Mahavidyas: the yantra -->
    <section class="chapter dv-move" id="kali-and-the-mahavidyas" data-chapter="devC_vidyas" data-dev-chapter="vidyas">
      {alias('vidyas').map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
      <div class="chapter-inner dv-inner">
        <header class="dv-head">
          <p class="kicker" data-fade>I · {catName('vidyas')}</p>
          <h2 class="display-l" data-split data-dust>{mv.vidyas.title}</h2>
          <p class="lede" data-fade><Rich text={mv.vidyas.lede} /></p>
        </header>
        <ol class="vidyas" data-fade>
          {MAHAVIDYAS.map((v, i) => (
            <li class="vidya" style={`--i:${i}`}>
              <span class="vidya-deva" lang="sa">{v.deva}</span>
              <span class="vidya-name">{v.name}</span>
              <button type="button" class="vidya-keep" data-keep={v.service} data-keep-p={p.name} aria-pressed="false" aria-label={SW.keepLabel.replace('{name}', v.service)}>{SW.keep}</button>
            </li>
          ))}
          <li class="vidya-bindu" aria-hidden="true"></li>
        </ol>
        <ul class="vidya-lines" data-fade>
          {MAHAVIDYAS.map((v) => <li><b>{v.name}</b> {v.line}</li>)}
        </ul>
        {COPY.allTen.service && <p class="dv-also" data-fade><button type="button" class="pp-item" data-keep={COPY.allTen.service} data-keep-p={p.name} aria-pressed="false">{COPY.allTen.label || COPY.allTen.service}</button></p>}
        {more.vidyas.length > 0 && <div class="dv-chips" data-fade><p class="kicker">{COPY.more}</p><ul>{more.vidyas.map((t) => <li><button type="button" class="chip-keep" data-keep={t} data-keep-p={p.name} aria-pressed="false">{t}</button></li>)}</ul></div>}
      </div>
    </section>

    <!-- II · the Devi and the Hindu deities: the yantra continues -->
    <section class="chapter dv-move" id="the-devi-and-the-hindu-deities" data-chapter="devC_devi" data-dev-chapter="devi">
      {alias('devi').map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
      <div class="chapter-inner dv-inner">
        <header class="dv-head">
          <p class="kicker" data-fade>II · {catName('devi')}</p>
          <h2 class="display-l" data-split data-dust>{mv.devi.title}</h2>
          <p class="lede" data-fade><Rich text={mv.devi.lede} /></p>
        </header>
        <ul class="deity-grid" data-fade>
          {HINDU.map((d) => (
            <li class="deity-card">
              <span class="deity-script" lang="sa">{d.deva}</span>
              <span class="deity-name">{d.name}</span>
              <span class="deity-line">{d.line}</span>
              <button type="button" class="vidya-keep" data-keep={d.service} data-keep-p={p.name} aria-pressed="false" aria-label={SW.keepLabel.replace('{name}', d.service)}>{SW.keep}</button>
            </li>
          ))}
        </ul>
        <div class="dv-chips" data-fade>
          <p class="kicker">{COPY.deviAlso.kicker}</p>
          <ul>{HINDU_ALSO.map((t) => <li><button type="button" class="chip-keep" data-keep={t} data-keep-p={p.name} aria-pressed="false">{t}</button></li>)}</ul>
          <p class="kicker">{COPY.tantra.kicker}</p>
          <ul>{TANTRA.map((t) => <li><button type="button" class="chip-keep" data-keep={t} data-keep-p={p.name} aria-pressed="false">{t}</button></li>)}</ul>
          {more.devi.length > 0 && <Fragment><p class="kicker">{COPY.more}</p><ul>{more.devi.map((t) => <li><button type="button" class="chip-keep" data-keep={t} data-keep-p={p.name} aria-pressed="false">{t}</button></li>)}</ul></Fragment>}
        </div>
      </div>
    </section>

    <!-- III · the Greek gods: the temple and the five elements -->
    <section class="chapter dv-move dv-greek" id="the-greek-gods" data-chapter="devC_greek" data-dev-chapter="greek">
      {alias('greek').map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
      <div class="meander" aria-hidden="true"></div>
      <div class="chapter-inner dv-inner">
        <header class="dv-head">
          <p class="kicker" data-fade>III · {catName('greek')} · {greekItems.length} services</p>
          <h2 class="display-l" data-split data-dust>{mv.greek.title}</h2>
          <p class="lede" data-fade><Rich text={mv.greek.lede} /></p>
        </header>
        <figure class="roots" data-fade>
          <ul aria-hidden="true">{ELEMENTS.map((e) => <li><svg viewBox="-20 -20 40 40"><path d={e.symbol} /></svg><small lang="grc">{e.greek}</small></li>)}</ul>
          <figcaption>{COPY.greek.rootsCaption}</figcaption>
        </figure>
        <div class="elements" role="group" aria-label={SW.familyOfGods} data-fade data-elements>
          <button type="button" data-el="all" aria-pressed="true"><span class="el-all">{COPY.greek.allLabel}</span></button>
          {FAMILIES.map((f) => <button type="button" data-el={f.key} aria-pressed="false"><span>{f.name}</span></button>)}
        </div>
        <ul class="greek-grid" data-greek-grid data-fade>
          {greekCards.map((g) => (
            <li class={`greek-card${g.presiding ? ' is-presiding' : ''}`} data-el={g.fam}>
              {g.presiding && <span class="presiding-tag">{COPY.greek.presidingTag}</span>}
              <span class="greek-script" lang="grc">{g.greek}</span>
              <span class="deity-name">{g.name}</span>
              <span class="deity-line">{g.line}</span>
              {g.presiding && <a class="presiding-link" href="/pillars/magic#hecate">{COPY.greek.presidingLink}</a>}
              <ul class="greek-work">{g.items.map((it) => <li><button type="button" class="chip-keep" data-keep={it} data-keep-p={p.name} aria-pressed="false">{it === g.name ? `${g.name} working` : it}</button></li>)}</ul>
            </li>
          ))}
        </ul>
        <div class="dv-chips" data-fade>
          <p class="kicker">{COPY.greek.pantheonKicker}</p>
          <ul>{pantheon.map((t) => <li><button type="button" class="chip-keep" data-keep={t} data-keep-p={p.name} aria-pressed="false">{t}</button></li>)}</ul>
        </div>
      </div>
    </section>

    <!-- IV · many traditions: the stars -->
    <section class="chapter dv-move" id="many-traditions" data-chapter="devC_lands" data-dev-chapter="lands">
      {alias('lands').map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
      <div class="chapter-inner dv-inner">
        <header class="dv-head">
          <p class="kicker" data-fade>IV · {catName('lands')}</p>
          <h2 class="display-l" data-split data-dust>{mv.lands.title}</h2>
          <p class="lede" data-fade><Rich text={mv.lands.lede} /></p>
        </header>
        <ul class="lands" data-fade>
          {LANDS.map((l) => (
            <li class="land">
              <p class="land-name">{l.land}</p>
              <ul>{l.names.map((t) => <li><button type="button" class="chip-keep" data-keep={t} data-keep-p={p.name} aria-pressed="false">{short(t)}</button></li>)}</ul>
            </li>
          ))}
        </ul>
        {more.lands.length > 0 && <div class="dv-chips" data-fade><p class="kicker">{COPY.more}</p><ul>{more.lands.map((t) => <li><button type="button" class="chip-keep" data-keep={t} data-keep-p={p.name} aria-pressed="false">{t}</button></li>)}</ul></div>}
      </div>
    </section>

    <!-- V · altars and devotion: lamps -->
    <section class="chapter dv-move" id="altars-and-devotion" data-chapter="devC_altar" data-dev-chapter="altar">
      {alias('altar').map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
      <div class="chapter-inner dv-inner">
        <header class="dv-head">
          <p class="kicker" data-fade>V · {catName('altar')}</p>
          <h2 class="display-l" data-split data-dust>{mv.altar.title}</h2>
          <p class="lede" data-fade><Rich text={mv.altar.lede} /></p>
        </header>
        <PillarSubs category={ch.altar} pillar={p.name} />
      </div>
    </section>

    <!-- VI · spirits and ancestors: a nebula -->
    <section class="chapter dv-move" id="spirits-mediumship-and-ancestors" data-chapter="devC_spirits" data-dev-chapter="spirits">
      {alias('spirits').map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
      <div class="chapter-inner dv-inner">
        <header class="dv-head">
          <p class="kicker" data-fade>VI · {categoryCount(ch.spirits)} services</p>
          <h2 class="display-l" data-split data-dust>{mv.spirits.title}</h2>
          <p class="lede" data-fade><Rich text={mv.spirits.lede} /></p>
          <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={mv.spirits.title}>{words.ask}</a></div>
        </header>
        <PillarSubs category={ch.spirits} pillar={p.name} />
      </div>
    </section>

    <!-- VII · shamanic work: the world tree and the drum -->
    <section class="chapter dv-move dv-shaman" id="shamanic-work" data-chapter="devC_shaman" data-dev-chapter="shaman">
      {alias('shaman').map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
      <div class="chapter-inner dv-inner dv-split">
        <header class="dv-head">
          <p class="kicker" data-fade>VII · {categoryCount(ch.shaman)} services</p>
          <h2 class="display-l" data-split data-dust>{mv.shaman.title}</h2>
          <p class="lede" data-fade><Rich text={mv.shaman.lede} /></p>
          <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={mv.shaman.title}>{words.ask}</a></div>
        </header>
        <svg class="drum" viewBox="-110 -110 220 220" aria-hidden="true" data-fade>
          <circle r="96" class="drum-rim" /><circle r="88" class="drum-skin" />
          <path class="drum-line" d="M0 60 L0 -44 M0 -10 C-20 -24 -34 -40 -40 -60 M0 -22 C18 -36 30 -50 36 -66 M0 -40 C-8 -52 -10 -62 -8 -72 M0 60 C-16 66 -30 72 -44 66 M0 60 C14 68 28 74 40 70 M0 44 C-12 52 -22 52 -30 48" />
          <ellipse class="drum-line thin" rx="70" ry="10" cy="-64" /><ellipse class="drum-line thin" rx="80" ry="10" cy="6" /><ellipse class="drum-line thin" rx="66" ry="9" cy="66" />
          <circle class="drum-dot" cx="-56" cy="-30" r="7" /><path class="drum-line" d="M52 -34 A12 12 0 1 1 52 -10 A9 9 0 1 0 52 -34" />
        </svg>
        <div class="dv-split-full"><PillarSubs category={ch.shaman} pillar={p.name} /></div>
      </div>
    </section>

    <section class="chapter dv-close" data-chapter="devC_close" data-dev-chapter="close">
      <div class="chapter-inner narrow center">
        <p class="kicker" data-fade>{COPY.close.kicker}</p>
        <h2 class="display-l" data-split>{COPY.close.title}</h2>
        <p class="lede" data-fade>{COPY.close.lede}</p>
        <div class="cta-row center" data-fade>
          <a class="btn btn-solid" href="/connect" data-topic={p.name}>{COPY.close.button}</a>
          <a class="btn btn-ghost" href="/path">{words.path}</a>
        </div>
      </div>
    </section>

    <nav class="pp-nav" aria-label={SW.otherPillars}>
      <a href={`/pillars/${prev.slug}`}><span>{words.previous}</span><b transition:name={`pt-${prev.slug}`} data-pt>{prev.name}</b></a>
      <a href={`/pillars/${next.slug}`}><span>{words.next}</span><b transition:name={`pt-${next.slug}`} data-pt>{next.name}</b></a>
    </nav>
  </div>
</Base>
