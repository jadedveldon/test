---
/**
 * Pillar 4, Identity, Intimacy & the Body: five chapters gathered from the catalogue's subcategories, in the
 * Soft prism design (direction B, chosen; A and C are in the project history). A bright, gentle page where
 * light breaks into every colour. Affirming, trauma-aware copy; nothing explicit; people choose what to share.
 */
import { pillarService } from '../../seo/ld';
import Base from '../../layouts/Base.astro';
import { crumbWords as cw } from '../../config';
import { words } from '../../config';
import CareText from '../../components/CareText.astro';
import Rich from '../../components/Rich.astro';
import SubCards from '../../components/SubCards.astro';
import { pillars, categoryCount } from '../../data/site';
import { categoryAliases, gather } from '../../data/chapters';
import { CHAPTER_KEYS, CHAPTERS, COMFORT, COPY, SUPPORT, SUPPORT_HREF, WELCOME } from '../../data/identity';

const index = pillars.findIndex((p) => p.slug === 'identity');
const p = pillars[index];
const prev = pillars[(index + pillars.length - 1) % pillars.length];
const next = pillars[(index + 1) % pillars.length];
const ROMAN = ['I', 'II', 'III', 'IV', 'V'];
const moves = CHAPTERS.map((ch) => ({ ...ch, cat: gather(p, ch.key, ch.title, CHAPTER_KEYS), id: ch.key }));
const aliases = categoryAliases(p, CHAPTER_KEYS, Object.fromEntries(moves.map((m) => [m.key, m.id])));
const c = COPY.comfort;
---
<Base title={`${p.name} · Sarvakali`} sequence="id_hero" description={p.line} crumbs={[{ label: cw.pillars, href: '/#paths' }, { label: p.name }]} ld={[pillarService(p)]}>
  <div class="pd pd-identity" data-identity>
    <section class="chapter pd-hero" data-chapter="id_hero">
      <div class="chapter-inner pd-hero-grid">
        <div class="pd-hero-copy">
          <p class="kicker" data-hero>Pillar {index + 1} of {pillars.length} · {p.count} services</p>
          <h1 class="display-l pd-title" data-hero data-split transition:name="pt-identity" data-pt>{p.name}</h1>
          <p class="lede" data-hero>{p.line}</p>
          <p class="pd-note" data-hero><Rich text={WELCOME} /></p>
          <ol class="pd-index" data-hero aria-label="The chapters">
            {moves.map((m, i) => <li><a href={`#${m.id}`}><span class="pd-num" aria-hidden="true">{ROMAN[i]}</span><span class="pd-ix-title">{m.title}</span><span class="pd-ix-n">{categoryCount(m.cat)} services</span></a></li>)}
          </ol>
        </div>

        <div class="pd-sig" data-hero>
          <!-- your comfort, first: a private note for a first conversation -->
          <form class="comfort" id="comfort" data-comfort>
            <p class="kicker">{c.kicker}</p>
            <fieldset>
              <legend>{c.paceLegend}</legend>
              <div class="cf-opts">{COMFORT.pace.map((t, i) => <label><input type="radio" name="cf-pace" value={t} checked={i === 1} /><span>{t}</span></label>)}</div>
            </fieldset>
            <fieldset>
              <legend>{c.exploreLegend}</legend>
              <div class="cf-opts">{COMFORT.explore.map((t) => <label><input type="checkbox" name="cf-explore" value={t} /><span>{t}</span></label>)}</div>
            </fieldset>
            <fieldset>
              <legend>{c.waysLegend}</legend>
              <div class="cf-opts">{COMFORT.ways.map((t) => <label><input type="checkbox" name="cf-way" value={t} /><span>{t}</span></label>)}</div>
            </fieldset>
            <div class="cf-row">
              <label class="cf-field"><span>{c.nameLabel}</span><input name="cf-name" autocomplete="off" maxlength="40" /></label>
              <label class="cf-field"><span>{c.pronounsLabel}</span><input name="cf-pronouns" autocomplete="off" maxlength="30" placeholder={c.pronounsExample} /></label>
            </div>
            <label class="cf-field"><span>{c.avoidLabel}</span><input name="cf-avoid" autocomplete="off" maxlength="120" /></label>
            <div class="cta-row"><button type="submit" class="btn btn-ghost btn-sm">{c.make}</button></div>
            <div class="cf-note" data-comfort-note hidden>
              <pre data-comfort-text></pre>
              <div class="cta-row"><button type="button" class="btn btn-ghost btn-sm" data-comfort-copy>{c.copy}</button><a class="btn btn-ghost btn-sm" href="/connect" data-topic={p.name}>Request a conversation</a></div>
            </div>
            <p class="dv-sig-hint small">{c.hint}</p>
          </form>

        </div>
      </div>
    </section>

    {moves.map((m, i) => (
      <section class={`chapter pd-move id-${m.key}`} id={m.id} data-chapter={`id_${m.key}`}>
        {(aliases[m.key] || []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
        <div class="chapter-inner pd-inner">
          <header class="pd-head">
            <p class="kicker" data-fade><span class="pd-num">{ROMAN[i]}</span> · {categoryCount(m.cat)} services</p>
            <h2 class="display-l" data-split data-dust>{m.title}</h2>
            <p class="lede" data-fade>{m.line}</p>
            {m.care && <p class="pd-care" data-fade><CareText text={m.care} /></p>}
            {m.note && <p class="pd-note" data-fade><Rich text={m.note} /></p>}
            {m.key === 'queer' && <p class="pd-care" data-fade><CareText text={SUPPORT} /> <a href={SUPPORT_HREF} target="_blank" rel="noopener">{COPY.supportLink}</a> · <a href="/care">{words.care}</a></p>}
            <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={m.title}>{words.ask}</a></div>
          </header>
          <SubCards category={m.cat} pillar={p.name} />
        </div>
      </section>
    ))}

    <section class="chapter pd-close" data-chapter="id_close">
      <div class="chapter-inner narrow center">
        <p class="kicker" data-fade>{COPY.close.kicker}</p>
        <h2 class="display-l" data-split>{COPY.close.title}</h2>
        <p class="lede" data-fade>{COPY.close.lede}</p>
        <div class="cta-row center" data-fade>
          <a class="btn btn-solid" href="/connect" data-topic={p.name}>{COPY.close.button}</a>
          <a class="btn btn-ghost" href="/care">{words.care}</a>
        </div>
      </div>
    </section>

    <nav class="pp-nav" aria-label="Other pillars">
      <a href={`/pillars/${prev.slug}`}><span>{words.previous}</span><b transition:name={`pt-${prev.slug}`} data-pt>{prev.name}</b></a>
      <a href={`/pillars/${next.slug}`}><span>{words.next}</span><b transition:name={`pt-${next.slug}`} data-pt>{next.name}</b></a>
    </nav>
  </div>
</Base>
