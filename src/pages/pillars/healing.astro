---
/**
 * Pillar 3, Healing & Inner Work · Still water, with gold.
 * Night water and pearl (direction A) with the gold of golden repair (C).
 *   The opening: breathing patterns and a five-senses grounding, around a lotus
 *   I   Energy: the body of light, the seven chakras of the modern system
 *   II  Mind: a care note
 *   III Shadow: golden repair, a bowl in straight-cut pieces to set back with gold
 *   IV  Journaling: a prompt for today
 */
import Base from '../../layouts/Base.astro';
import { crumbWords as cw } from '../../config';
import { words } from '../../config';
import CareText from '../../components/CareText.astro';
import SubCards from '../../components/SubCards.astro';
import { pillars, categoryCount } from '../../data/site';
import { BREATH_CARE, BREATHS, CARE, CHAKRAS, CHAPTER_KEYS, CHAPTERS, COPY, GROUNDING, PROMPTS } from '../../data/healing';
import { categoryAliases, gather } from '../../data/chapters';
import Rich from '../../components/Rich.astro';

const index = pillars.findIndex((p) => p.slug === 'healing');
const p = pillars[index];
const prev = pillars[(index + pillars.length - 1) % pillars.length];
const next = pillars[(index + 1) % pillars.length];
const ROMAN = ['I', 'II', 'III', 'IV'];
/* each chapter keeps the address of the catalogue category it was made from, so links into the page keep working */
const IDS: Record<string, string> = { energy: 'energy-healing-aura-and-chakra', mind: 'mind-and-subconscious-work', shadow: 'shadow-work-and-inner-healing', journal: 'journaling-and-guided-reflection' };
const moves = CHAPTERS.map((ch) => ({ ...ch, cat: gather(p, ch.key, ch.title, CHAPTER_KEYS), id: IDS[ch.key] }));
const aliases = categoryAliases(p, CHAPTER_KEYS, IDS);

/* the body of light: where each chakra sits on the figure, crown first */
const CK_Y = [-156, -128, -97, -62, -28, 6, 38];

/* golden repair: a bowl seen from above, cut by straight lines into twelve pieces */
type Pt = [number, number];
const R = 112;
const circle: Pt[] = Array.from({ length: 96 }, (_, k) => { const a = (k / 96) * Math.PI * 2; return [Math.cos(a) * R, Math.sin(a) * R] as Pt; });
const area = (poly: Pt[]) => Math.abs(poly.reduce((s, q, i) => { const r = poly[(i + 1) % poly.length]; return s + q[0] * r[1] - r[0] * q[1]; }, 0)) / 2;
const inside = (poly: Pt[], [x, y]: Pt) => { let c = false; for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) { const [xi, yi] = poly[i], [xj, yj] = poly[j]; if ((yi > y) !== (yj > y) && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) c = !c; } return c; };
function split(poly: Pt[], p0: Pt, d: Pt): Pt[][] {
  const side = (q: Pt) => d[0] * (q[1] - p0[1]) - d[1] * (q[0] - p0[0]);
  const A: Pt[] = [], B: Pt[] = [];
  poly.forEach((q, i) => {
    const r = poly[(i + 1) % poly.length], sq = side(q), sr = side(r);
    if (sq >= 0) A.push(q);
    if (sq <= 0) B.push(q);
    if ((sq > 0 && sr < 0) || (sq < 0 && sr > 0)) { const t = sq / (sq - sr); const x: Pt = [q[0] + (r[0] - q[0]) * t, q[1] + (r[1] - q[1]) * t]; A.push(x); B.push(x); }
  });
  return [A, B].filter((x) => x.length >= 3 && area(x) > 1);
}
// four long cuts, then three short cracks that each split only one piece
const CUTS: [number, number, number, boolean][] = [[0, -30, 6, false], [0, 38, -10, false], [-40, 0, 84, false], [36, 0, 98, false], [-2, 4, 52, true], [75, 70, 150, true], [-75, -70, 30, true]];
let polys: Pt[][] = [circle];
CUTS.forEach(([px, py, deg, local]) => {
  const d: Pt = [Math.cos((deg * Math.PI) / 180), Math.sin((deg * Math.PI) / 180)];
  polys = polys.flatMap((pc) => (!local || inside(pc, [px, py]) ? split(pc, [px, py], d) : [pc]));
});
const f1 = (v: number) => v.toFixed(1);
const pieces = polys.map((poly, i) => {
  const cx = poly.reduce((s, q) => s + q[0], 0) / poly.length, cy = poly.reduce((s, q) => s + q[1], 0) / poly.length;
  // the edges that were cut (not the rim) carry the gold once the piece is home
  const seams = poly.map((q, k) => [q, poly[(k + 1) % poly.length]]).filter(([a, b]) => Math.hypot((a[0] + b[0]) / 2, (a[1] + b[1]) / 2) < R * 0.985);
  // scattered: pushed out from the centre, and turned
  const len = Math.hypot(cx, cy) || 1, push = 46 + ((i * 37) % 30);
  const sx = (cx / len) * push + (((i * 53) % 21) - 10), sy = (cy / len) * push + (((i * 29) % 17) - 8), rot = (((i * 47) % 50) - 25);
  return {
    d: `M${poly.map((q) => `${f1(q[0])} ${f1(q[1])}`).join(' L')} Z`,
    seam: seams.map(([a, b]) => `M${f1(a[0])} ${f1(a[1])} L${f1(b[0])} ${f1(b[1])}`).join(' '),
    sx: f1(sx), sy: f1(sy), rot: String(rot),
  };
});
---
<Base title={`${p.name} · Sarvakali`} sequence="heal_hero" description={p.line} crumbs={[{ label: cw.pillars, href: '/#paths' }, { label: p.name }]}>
  <div class="hl" data-healing>
    <section class="chapter hl-hero" data-chapter="heal_hero" data-heal-chapter="hero">
      <div class="chapter-inner hl-hero-grid">
        <div class="hl-hero-copy">
          <p class="kicker" data-hero>Pillar {index + 1} of {pillars.length} · {p.count} services</p>
          <h1 class="display-l hl-title" data-hero data-split transition:name="pt-healing" data-pt>{p.name}</h1>
          <p class="lede" data-hero>{p.line}</p>
          <ol class="hl-index" data-hero aria-label="The four chapters">
            {moves.map((m, i) => (
              <li><a href={`#${m.id}`}><span class="hl-num" aria-hidden="true">{ROMAN[i]}</span><span class="hl-ix-title">{m.title}</span><span class="hl-ix-n">{categoryCount(m.cat)} services</span></a></li>
            ))}
          </ol>
        </div>

        <!-- breathe: several patterns, and a five-senses grounding -->
        <div class="breath" id="breathe" data-breath data-hero>
          <div class="br-modes" role="group" aria-label="Breathing patterns">
            {BREATHS.map((b, i) => <button type="button" data-breath-mode={b.key} aria-pressed={i === 0 ? 'true' : 'false'}>{b.name}</button>)}
            <button type="button" data-breath-mode="ground" aria-pressed="false">{COPY.breath.grounding.name}</button>
          </div>
          <div class="br-stage">
            <svg viewBox="-150 -150 300 300" class="breath-svg" aria-hidden="true">
              <circle r="132" class="br-ring" />
              <g data-breath-ripples></g>
              <circle r="104" class="br-full" />
              <circle r="40" class="br-core" data-breath-core />
              <circle r="40" class="br-hold" data-breath-hold />
              <g class="br-sides" data-breath-sides>
                <text x="-126" y="5" class="br-side" data-side="left">L</text>
                <text x="126" y="5" class="br-side" data-side="right">R</text>
              </g>
            </svg>
            <div class="br-read">
              <p class="br-word" data-breath-word aria-live="polite">{COPY.breath.idle}</p>
              <p class="br-count" data-breath-count aria-hidden="true"></p>
            </div>
            <ol class="br-ground" data-ground hidden>
              {GROUNDING.map((g) => <li data-step={g.n}><b>{g.n}</b> {g.sense}</li>)}
            </ol>
          </div>
          <p class="br-short" data-breath-short>{BREATHS[0].short}</p>
          <p class="br-about" data-breath-about>{BREATHS[0].about}</p>
          <button type="button" class="btn btn-ghost btn-sm" data-breath-toggle>{COPY.breath.begin}</button>
          <p class="br-care"><Rich text={BREATH_CARE} /></p>
        </div>
      </div>
    </section>

    {moves.map((m, i) => (
      <section class={`chapter hl-move hl-${m.key}`} id={m.id} data-chapter={`heal_${m.key}`} data-heal-chapter={m.key}>
        {(aliases[m.key] || []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
        <div class={`chapter-inner hl-inner${m.key === 'energy' || m.key === 'shadow' ? ' hl-split' : ''}`}>
          <header class="hl-head">
            <p class="kicker" data-fade><span class="hl-num">{ROMAN[i]}</span> · {categoryCount(m.cat)} services</p>
            <h2 class="display-l" data-split data-dust>{m.title}</h2>
            <p class="lede" data-fade>{m.line}</p>
            {m.care && <p class="hl-care" data-fade><CareText text={CARE} /> <a href="/care">Read {words.care}</a>.</p>}
            <div class="cta-row" data-fade><a class="btn btn-ghost btn-sm" href="/connect" data-topic={m.title}>{words.ask}</a></div>
          </header>

          {m.key === 'energy' && (
            <div class="bodylight" data-body data-fade>
              <svg viewBox="-120 -182 240 290" class="body-svg">
                <circle cx="0" cy="-128" r="22" class="bl-figure" />
                <path class="bl-figure" d="M-11 -106 L-11 -97 C-40 -95 -58 -87 -62 -62 L-66 -2 C-69 18 -78 32 -94 50 C-104 62 -96 78 -70 78 L70 78 C96 78 104 62 94 50 C78 32 69 18 66 -2 L62 -62 C58 -87 40 -95 11 -97 L11 -106" />
                <line x1="0" y1="-170" x2="0" y2="52" class="bl-line" />
                {CHAKRAS.map((c, k) => (
                  <g class="bl-node" data-ck={k} transform={`translate(0 ${CK_Y[k]})`} style={`--ck:${c.color}`} tabindex="0" role="button" aria-label={`${c.english}: ${c.name}`}>
                    <circle r="15" class="bl-halo" /><circle r="7.5" class="bl-dot" />
                  </g>
                ))}
              </svg>
              <div class="bl-info" aria-live="polite">
                <p class="kicker">{COPY.body.kicker}</p>
                <p class="bl-deva" lang="sa" data-bl-deva>{CHAKRAS[3].deva}</p>
                <h3 class="bl-name" data-bl-name>{CHAKRAS[3].name} · {CHAKRAS[3].english}</h3>
                <p class="bl-place" data-bl-place>Placed {CHAKRAS[3].place}.</p>
                <button type="button" class="chip-keep" data-bl-work data-keep={CHAKRAS[3].working} data-keep-p={p.name} aria-pressed="false">{CHAKRAS[3].working}</button>
                <p class="dv-sig-hint small">{COPY.body.hint}</p>
              </div>
            </div>
          )}

          {m.key === 'shadow' && (
            <div class="mend" data-mend data-fade>
              <p class="kicker">{COPY.mend.kicker}</p>
              <svg viewBox="-185 -185 370 370" class="mend-svg" data-mend-svg>
                <circle r={R} class="md-guide" />
                <circle r="44" class="md-foot" data-mend-foot />
                {pieces.map((pc, k) => (
                  <g class="md-piece" data-piece={k} data-home-x="0" transform={`translate(${pc.sx} ${pc.sy}) rotate(${pc.rot})`} tabindex="0" role="button" aria-label={`Piece ${k + 1} of ${pieces.length}`}>
                    <path d={pc.d} class="md-clay" />
                    <path d={pc.seam} class="md-seam" />
                  </g>
                ))}
              </svg>
              <p class="br-word" data-mend-word aria-live="polite">{COPY.mend.start}</p>
              <button type="button" class="btn btn-ghost btn-sm" data-mend-all>{COPY.mend.all}</button>
              <p class="dv-sig-hint" data-mend-note hidden>{COPY.mend.note}</p>
            </div>
          )}

          {m.key === 'journal' && (
            <div class="prompt-card" data-prompt data-fade>
              <p class="kicker">{COPY.prompt.kicker}</p>
              <p class="prompt-text" data-prompt-text>{PROMPTS[0]}</p>
              <div class="cta-row"><button type="button" class="btn btn-ghost btn-sm" data-prompt-next>{COPY.prompt.next}</button></div>
              <p class="dv-sig-hint small">{COPY.prompt.hint}</p>
            </div>
          )}
          <SubCards category={m.cat} pillar={p.name} />
        </div>
      </section>
    ))}

    <section class="chapter hl-close" data-chapter="heal_close" data-heal-chapter="close">
      <div class="chapter-inner narrow center">
        <p class="kicker" data-fade>{COPY.close.kicker}</p>
        <h2 class="display-l" data-split>{COPY.close.title}</h2>
        <p class="lede" data-fade>{COPY.close.lede}</p>
        <div class="cta-row center" data-fade>
          <a class="btn btn-solid" href="/connect" data-topic={p.name}>{COPY.close.button}</a>
          <a class="btn btn-ghost" href="/care">{words.care}</a>
        </div>
      </div>
    </section>

    <nav class="pp-nav" aria-label="Other pillars">
      <a href={`/pillars/${prev.slug}`}><span>{words.previous}</span><b transition:name={`pt-${prev.slug}`} data-pt>{prev.name}</b></a>
      <a href={`/pillars/${next.slug}`}><span>{words.next}</span><b transition:name={`pt-${next.slug}`} data-pt>{next.name}</b></a>
    </nav>
  </div>
</Base>
