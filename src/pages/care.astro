---
/**
 * Boundaries and care (/care): what the work is and is not, what Sarvakali will and will not do, privacy, payments.
 * Every word is in src/content/pages/care.json ("Boundaries and care" in the content editor): the parts can be
 * added, removed, reordered and renamed there. A part whose address is "privacy" is where /care#privacy leads.
 */
import Base from '../layouts/Base.astro';
import Rich from '../components/Rich.astro';
import w from '../content/pages/care.json';
const sections = w.sections.filter((s) => s.title?.trim() || s.paras.some((p) => p.trim()) || s.points.some((p) => p.trim()));
---
<Base title={w.meta.title} sequence="care" description={w.meta.description}>
  <article class="page">
    <header class="page-hero">
      <p class="kicker" data-hero>{w.kicker}</p>
      <h1 class="display-l" data-hero data-split>{w.title}</h1>
      {w.lede ? <p class="lede" data-hero>{w.lede}</p> : null}
      {w.draftNote?.trim() ? <p class="proto-flag" data-hero>{w.draftNote}</p> : null}
    </header>

    <div class="prose page-body">
      {w.crisis?.text?.trim() ? (
        <section class="care-box" data-fade aria-labelledby="crisis">
          <h2 id="crisis">{w.crisis.title}</h2>
          <p><Rich text={w.crisis.text} /></p>
        </section>
      ) : null}
      {sections.map((s) => (
        <section data-fade id={s.id || undefined} aria-labelledby={s.id ? `${s.id}-h` : undefined}>
          {s.title ? <h2 id={s.id ? `${s.id}-h` : undefined}>{s.title}</h2> : null}
          {s.paras.filter((p) => p.trim()).map((p) => <p><Rich text={p} /></p>)}
          {s.points.some((p) => p.trim()) ? <ul>{s.points.filter((p) => p.trim()).map((p) => <li><Rich text={p} /></li>)}</ul> : null}
        </section>
      ))}
    </div>
  </article>
</Base>
