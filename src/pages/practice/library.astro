---
/**
 * The library (/practice/library): prayers of every tradition. Ways in by tradition, by need and by day; how to use
 * it and what its labels mean; and everything in it, to search and filter by day, tradition, figure, intention and
 * kind (src/scripts/mantra.ts). Words: src/content/pages/library.json ("Mantra library" in the content editor).
 * Without scripts, everything is simply listed, and the ways in are plain links.
 */
import Base from '../../layouts/Base.astro';
import { crumbWords as cw } from '../../config';
import MantraCard from '../../components/MantraCard.astro';
import CareText from '../../components/CareText.astro';
import Rich from '../../components/Rich.astro';
import { DAYS, DAY_HEX, DAY_GLYPH, deitiesOf, loadMantras, traditionsOf, tradKey, type DayKey } from '../../data/mantras';
import w from '../../content/pages/library.json';

const all = await loadMantras();
const deities = deitiesOf(all);
const themes = Object.entries(w.themes).filter(([k]) => all.some((m) => m.themes.includes(k)));
const traditions = traditionsOf(all);
const kinds = Object.entries(w.kinds).filter(([k]) => all.some((m) => m.kind === k));
const lib = (q: string) => `/practice/library?${q}#all`;
const L = w.labels;
---
<Base title={w.meta.title} sequence="library" description={w.meta.description} crumbs={[{ label: cw.practice, href: '/practice' }, { label: cw.library }]}>
  <div class="plib" data-library>
    <section class="chapter" data-chapter="library">
      <div class="chapter-inner">
        <p class="kicker" data-hero>{w.kicker}</p>
        <h1 class="display-l" data-hero data-split>{w.title}</h1>
        <p class="lede" data-hero>{w.lede}</p>
        <p class="plib-start" data-hero><Rich text={w.start} /></p>
        <nav class="week-strip" aria-label={w.dayWords.weekLabel} data-hero>
          {DAYS.map((x) => <a href={`/practice/${x.key}`} style={`--dc:${DAY_HEX[x.key as DayKey]}`}><span class="ws-glyph" aria-hidden="true">{DAY_GLYPH[x.key as DayKey]}</span><span class="ws-name">{x.name}</span><span class="ws-planet">{x.planet}</span></a>)}
        </nav>
      </div>
    </section>

    <section class="chapter" data-chapter="library" id="ways">
      <div class="chapter-inner plib-ways">
        <h2 class="display-m" data-fade>{w.ways.title}</h2>
        <div class="plib-way" data-fade>
          <h3 class="kicker">{w.ways.byTradition}</h3>
          <ul class="plib-shelf">{traditions.map((t) => <li><a href={lib(`tradition=${tradKey(t.name)}`)}><span>{t.name}</span><small>{t.count}</small></a></li>)}</ul>
        </div>
        <div class="plib-way" data-fade>
          <h3 class="kicker">{w.ways.byNeed}</h3>
          <ul class="plib-shelf plib-shelf-need">{themes.map(([k, v]) => <li><a href={lib(`theme=${k}`)}>{v}</a></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="chapter" data-chapter="library">
      <div class="chapter-inner plib-how">
        <div data-fade>
          <h2 class="display-m">{w.how.title}</h2>
          {w.how.paras.map((p) => <p>{p}</p>)}
          <div class="pday-rhythm"><h3 class="kicker">{w.rhythm.title}</h3><p>{w.rhythm.text}</p></div>
        </div>
        <aside role="none" data-fade>
          <h2 class="kicker">{L.title}</h2>
          <dl class="plib-labels">
            <dt><span class="mc-badge mc-badge-open">{L.open}</span></dt><dd>{L.openText}</dd>
            <dt><span class="mc-badge mc-badge-guidance">{L.guidance}</span></dt><dd>{L.guidanceText}</dd>
            <dt><span class="mc-badge mc-badge-variant">{L.variant}</span></dt><dd>{L.variantText}</dd>
            <dt><span class="mc-badge mc-badge-verify">{L.verify}</span></dt><dd>{L.verifyText}</dd>
            <dt><span class="mc-badge mc-badge-honoured">{L.honoured}</span></dt><dd>{L.honouredText}</dd>
            <dt><span class="mc-drafted">{L.drafted}</span></dt><dd>{L.draftedText}</dd>
          </dl>
          <div class="pday-care"><CareText text={w.care} /></div>
        </aside>
      </div>
    </section>

    <section class="chapter" data-chapter="library" id="all">
      <div class="chapter-inner">
        <h2 class="display-m">{w.every}</h2>
        <form class="plib-filters" data-filters role="search">
          <label class="plib-search"><span class="sr-only">{w.search}</span><input type="search" data-f-q placeholder={w.searchHint} autocomplete="off" /></label>
          <fieldset class="plib-chips">
            <legend class="sr-only">{w.dayLegend}</legend>
            <label><input type="radio" name="f-day" value="" checked data-f-day /> <span>{w.allDays}</span></label>
            {DAYS.map((x) => <label style={`--dc:${DAY_HEX[x.key as DayKey]}`}><input type="radio" name="f-day" value={x.key} data-f-day /> <span>{x.name}</span></label>)}
            <label><input type="radio" name="f-day" value="any" data-f-day /> <span>{w.anyDayChip}</span></label>
          </fieldset>
          <details class="plib-narrow" open data-plib-narrow>
          <summary>{w.narrow}</summary>
          <div class="plib-row">
            <label>{w.tradition} <select data-f-tradition><option value="">{w.anyTradition}</option>{traditions.map((t) => <option value={tradKey(t.name)}>{t.name}</option>)}</select></label>
            <label>{w.deity} <select data-f-deity><option value="">{w.anyDeity}</option>{deities.map((d) => <option value={d}>{d}</option>)}</select></label>
            <label>{w.intention} <select data-f-theme><option value="">{w.anyDeity}</option>{themes.map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
            <label>{w.kind} <select data-f-kind><option value="">{w.anyDeity}</option>{kinds.map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
            <label class="plib-check"><input type="checkbox" checked data-f-guidance /> {w.include}</label>
          </div>
          <div class="mc-controls" data-mc-controls>
            <span class="hint">{w.controls.show}</span>
            <label><input type="checkbox" checked data-show-script="deva" /> {w.controls.script}</label>
            <label><input type="checkbox" checked data-show-script="iast" /> {w.controls.iast}</label>
            <label><input type="checkbox" checked data-show-script="read" /> {w.controls.read}</label>
          </div>
          </details>
          <p class="hint plib-count" aria-live="polite" data-f-count data-template={w.count} data-total={all.length}>{all.length}</p>
        </form>
        <p class="plib-none" data-f-none hidden>{w.none} <button type="button" class="path-back" data-f-clear>{w.clear}</button></p>
        <div class="mc-grid plib-grid">{all.map((m) => <MantraCard m={m} showDays />)}</div>
      </div>
    </section>
  </div>
</Base>
