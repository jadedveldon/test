---
/**
 * One day of the week (/practice/monday … /practice/sunday): the day and its planet, its question, and first of all
 * its one guided practice; then, folded away for those who want them, the day's character, intention and themes,
 * all its mantras in their groups, and the other traditions' connections. Words: src/content/pages/week.json ("The seven days" in the content editor); mantras:
 * src/content/mantras ("Mantras"). The planetary text is symbolism for reflection, as the library says.
 */
import Base from '../../layouts/Base.astro';
import { crumbWords as cw } from '../../config';
import MantraCard from '../../components/MantraCard.astro';
import CareText from '../../components/CareText.astro';
import { DAYS, DAY_KEYS, DAY_WORLD, DAY_HEX, DAY_GLYPH, dayOf, dayPath, groupsFor, loadMantras, loadPractices, practicePath, STEP_ICON, type DayKey } from '../../data/mantras';
import lib from '../../content/pages/library.json';

export function getStaticPaths() {
  return DAY_KEYS.map((day) => ({ params: { day } }));
}
const key = Astro.params.day as DayKey;
const d = dayOf(key);
const all = await loadMantras();
const groups = groupsFor(all, key);
const world = DAY_WORLD[key];
const i = DAY_KEYS.indexOf(key);
const prev = dayOf(DAY_KEYS[(i + 6) % 7]);
const next = dayOf(DAY_KEYS[(i + 1) % 7]);
const noteFor = (g: string) => d.groupNotes?.find((n) => n.group === g)?.text;
const count = groups.reduce((n, g) => n + g.mantras.length, 0);
const practice = (await loadPractices()).find((p) => p.kind === 'day' && p.key === key);
const dw = lib.dayWords;
const fill = (t: string, v: Record<string, string | number>) => Object.entries(v).reduce((a, [k, x]) => a.replaceAll(`{${k}}`, String(x)), t);
const C = lib.controls;
const nameOf = (slug?: string | null) => all.find((m) => m.slug === slug)?.name;
---
<Base title={fill(dw.metaTitle, { day: d.name, sanskrit: d.sanskrit })} sequence={world} description={fill(dw.metaDescription, { day: d.name, planet: d.planet, question: d.question })} crumbs={[{ label: cw.practice, href: '/practice' }, { label: d.name }]}>
  <div class="pday" data-practice-day data-day={key} style={`--day:${DAY_HEX[key]}`}>
    <section class="chapter" data-chapter={world}>
      <div class="chapter-inner">
        <nav class="week-strip" aria-label={dw.weekLabel} data-hero>
          {DAYS.map((x) => <a href={dayPath(x.key)} aria-current={x.key === key ? 'page' : undefined} style={`--dc:${DAY_HEX[x.key as DayKey]}`} data-week-day={x.key}><span class="ws-glyph" aria-hidden="true">{DAY_GLYPH[x.key as DayKey]}</span><span class="ws-name">{x.name.slice(0, 3)}</span></a>)}
        </nav>
        <p class="kicker" data-hero><span data-today-badge hidden>{dw.today} · </span>{d.planet} · {d.planetSanskrit}</p>
        <h1 class="display-l" data-hero data-split>{d.name}</h1>
        <p class="pday-sk" data-hero lang="sa-Latn">{d.sanskrit} <span class="pday-glyph" aria-hidden="true">{DAY_GLYPH[key]}</span></p>
        <blockquote class="pday-question" data-hero><p class="kicker">{dw.question}</p><p>{d.question}</p></blockquote>
        <div class="cta-row" data-hero>
          {practice ? <a class="btn btn-solid" href={practicePath(practice.slug)}>{fill(dw.begin, { day: d.name })}</a> : null}
          <a class="btn btn-ghost" href="#about">{fill(dw.about, { day: d.name })}</a>
        </div>
        {practice ? (
          <div class="ps-plan pday-plan" data-hero>
            <p class="kicker">{fill(dw.planMinutes, { title: practice.title, n: practice.minutes })}</p>
            <ol class="ps-outline">{practice.steps.map((s) => <li><span class="ps-ico" aria-hidden="true">{STEP_ICON[s.type]}</span><span>{s.title}{nameOf(s.mantra) ? <small>{nameOf(s.mantra)}</small> : null}</span></li>)}</ol>
          </div>
        ) : null}
      </div>
    </section>

    <section class="chapter" data-chapter={world} id="about">
      <div class="chapter-inner pday-about">
        <details class="pday-fold" data-fade>
        <summary><span class="display-m">{fill(dw.about, { day: d.name })}</span><span class="hint">{dw.aboutHint}</span></summary>
        <div class="pday-care"><CareText text={lib.care} /></div>
        <div class="pday-cols">
          <div data-fade>
            <h2 class="display-m">{dw.character}</h2>
            {d.character.map((p) => <p>{p}</p>)}
            <h2 class="display-m">{dw.intention}</h2>
            <p>{d.intention}</p>
          </div>
          <aside role="none" data-fade>
            <h2 class="kicker">{dw.themes}</h2>
            <ul class="pday-themes">{d.themes.map((t) => <li>{t}</li>)}</ul>
            <div class="pday-rhythm">
              <h2 class="kicker">{fill(dw.gentle, { day: d.name })}</h2>
              <p>{d.practice}</p>
              <p class="hint">{lib.rhythm.text}</p>
            </div>
          </aside>
        </div>
        </details>
      </div>
    </section>

    <section class="chapter" data-chapter={world} id="mantras">
      <div class="chapter-inner">
        <details class="pday-fold" data-fade>
        <summary><span class="display-m">{fill(dw.all, { n: count, day: d.name })}</span><span class="hint">{dw.allHint}</span></summary>
        <div class="mc-controls" data-mc-controls>
          <span class="hint">{C.show}</span>
          <label><input type="checkbox" checked data-show-script="deva" /> {C.script}</label>
          <label><input type="checkbox" checked data-show-script="iast" /> {C.iast}</label>
          <label><input type="checkbox" checked data-show-script="read" /> {C.read}</label>
        </div>
        {groups.map((g) => (
          <div class="mc-group">
            <h3 class="display-m mc-group-title">{g.name}</h3>
            {noteFor(g.name) ? <p class="mc-group-note">{noteFor(g.name)}</p> : null}
            <div class="mc-grid">{g.mantras.map((m) => <MantraCard m={m} headingLevel="h4" />)}</div>
          </div>
        ))}
        </details>
      </div>
    </section>

    {d.others?.items?.length ? (
      <section class="chapter" data-chapter="traditions">
        <div class="chapter-inner narrow">
          <p class="kicker" data-fade>{dw.acrossKicker}</p>
          <h2 class="display-m" data-fade>{d.others.title}</h2>
          {d.others.text ? <p class="lede" data-fade>{d.others.text}</p> : null}
          <ul class="pday-others" data-fade>{d.others.items.map((t) => { const [h, ...rest] = t.split(': '); return <li>{rest.length ? <><b>{h}:</b> {rest.join(': ')}</> : t}</li>; })}</ul>
          <p data-fade><a class="btn btn-ghost btn-sm" href="/practice/library#ways">{dw.acrossLink} →</a></p>
        </div>
      </section>
    ) : null}

    <section class="chapter" data-chapter="close">
      <div class="chapter-inner pday-next">
        <a class="pday-step" href={dayPath(prev.key)} style={`--dc:${DAY_HEX[prev.key as DayKey]}`}><span class="hint">{dw.before}</span><span class="display-m">{prev.name}</span><span class="hint">{prev.planet}</span></a>
        <a class="pday-step pday-lib" href="/practice/library"><span class="hint">{dw.libraryHint}</span><span class="display-m">{dw.library}</span><span class="hint">{dw.libraryBy}</span></a>
        <a class="pday-step" href={dayPath(next.key)} style={`--dc:${DAY_HEX[next.key as DayKey]}`}><span class="hint">{dw.after}</span><span class="display-m">{next.name}</span><span class="hint">{next.planet}</span></a>
      </div>
    </section>
  </div>
</Base>
