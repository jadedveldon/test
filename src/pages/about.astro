---
/**
 * About: the one page about a person rather than the work. The portrait opens into depth (the depth demo's
 * technique); until Sarvakali's own photograph is in, a public-domain Kalighat painting stands in for it.
 * The words are in src/content/pages/about.json ("About" in the content editor), where Sarvakali can write the
 * story; bracketed lines are theirs to write.
 */
import Base from '../layouts/Base.astro';
import Rich from '../components/Rich.astro';
import { ICONS } from '../data/icons';
import a from '../content/pages/about.json';

const promises = a.promises.items.filter((p) => p.title.trim());
const portrait = { img: '/depth/kali-163.jpg', depth: '/depth/kali-163-depth.png', w: 1100, h: 1755, alt: 'Kali, an unfinished study: Kalighat painting, Calcutta, nineteenth century' };
---
<Base title="About · Sarvakali" sequence="about" description="About Sarvakali: the person behind the institute, and how the work is held.">
  <article class="about">
    <header class="about-hero">
      <div class="about-hero-copy">
        <p class="kicker" data-hero>{a.hero.kicker}</p>
        <h1 class="display-l" data-hero data-split>{a.hero.title}</h1>
        <p class="lede" data-hero>{a.hero.lede}</p>
        <p class="proto-flag" data-hero>Placeholder page: the lines in brackets are for Sarvakali to write, in the content editor.</p>
      </div>
      <figure class="about-portrait" data-depth data-hero>
        <div class="depth-stage about-stage" role="img" aria-label={`${portrait.alt}. Move your pointer, drag, or use the arrow keys to look into it.`}>
          <div class="depth-work" data-work-pane="portrait" style={`aspect-ratio: ${portrait.w} / ${portrait.h}`}>
            <img class="depth-img" src={portrait.img} alt="" width={portrait.w} height={portrait.h} loading="eager" />
            <img class="depth-map" src={portrait.depth} alt="" aria-hidden="true" width={portrait.w} height={portrait.h} loading="lazy" hidden />
          </div>
          <canvas class="depth-canvas" aria-hidden="true"></canvas>
        </div>
        <figcaption>
          <span><Rich text={a.portrait.caption} /></span>
          <span class="about-hint">{a.portrait.hint}</span>
        </figcaption>
      </figure>
    </header>

    {a.quote.trim() && (
      <blockquote class="about-quote" data-fade>
        <p data-split>{a.quote}</p>
      </blockquote>
    )}


    <section class="about-promises">
      <h2 class="display-m" data-fade>{a.promises.title}</h2>
      <ul class="promises">
        {promises.map((p) => (
          <li data-fade>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[p.icon] ?? ICONS.circle} /></svg>
            <b>{p.title}</b>
            <span><Rich text={p.text} /></span>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-for" data-fade>
      <h2 class="display-m">{a.forWhom.title}</h2>
      <p class="lede"><Rich text={a.forWhom.text} /></p>
      <div class="cta-row">
        <a class="btn btn-solid" href="/connect">{a.close.primary}</a>
        <a class="btn btn-ghost" href="/care">{a.close.secondary}</a>
      </div>
    </section>
  </article>
</Base>
