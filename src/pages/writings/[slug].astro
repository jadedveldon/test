---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { pillars } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('writings');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const pillar = pillars.find((p) => p.slug === post.data.pillar)!;
const others = (await getCollection('writings')).filter((p) => p.id !== post.id);
---
<Base title={`${post.data.title} · Sarvakali`} sequence="reading" description={post.data.summary}>
  <article class="page">
    <header class="page-hero">
      <a class="back-link" href="/writings">← All writings</a>
      <p class="kicker" data-hero>{pillar.name} · {post.data.minutes} min read</p>
      <h1 class="display-l" data-hero data-split transition:name={`wt-${post.id}`} data-pt>{post.data.title}</h1>
      <p class="lede" data-hero>{post.data.summary}</p>
    </header>
    <div class="prose page-body article" data-fade>
      <Content />
    </div>
    <aside class="page-body article-end" data-fade>
      <div class="cta-row">
        <a class="btn btn-solid" href="/connect" data-topic={post.data.title}>Ask about this</a>
        <a class="btn btn-ghost" href={`/pillars/${pillar.slug}`}>Explore {pillar.name}</a>
      </div>
      <p class="kicker">Read next</p>
      <ul class="writing-next">
        {others.map((o) => <li><a href={`/writings/${o.id}`}>{o.data.title}</a></li>)}
      </ul>
    </aside>
  </article>
</Base>
