---
/**
 * Connect: request a conversation. Beside the form, what happens next (the homepage's How it works, so both
 * always agree). The services a visitor kept appear as chips they can remove; their own words go in the box.
 * The words are in src/content/pages/connect.json ("Connect" in the content editor). Sending puts the request in
 * Sarvakali's Studio (src/studio), emails both of them, and gives the visitor a page to follow it on; their list
 * then empties. In the preview the request goes to the Studio's demo, in the same browser.
 */
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import Rich from '../components/Rich.astro';
import c from '../content/pages/connect.json';
import b from '../content/pages/booking.json';
const f = c.form;
const d = b.connectDone;
const mode = import.meta.env.PUBLIC_STUDIO;
---
<Base title="Connect · Sarvakali" sequence="connect" description="Request a conversation with Sarvakali.">
  <section class="connect">
    <div class="connect-intro">
      <p class="kicker" data-hero>{c.kicker}</p>
      <h1 class="display-l" data-hero data-split>{c.title}</h1>
      <p class="lede" data-hero>{c.lede}</p>
    </div>

    <!-- beside the form on wide screens; after it on phones, so the form comes first -->
    <div class="connect-aside">
      <div class="connect-next" data-hero>
        <p class="kicker">{c.next}</p>
        <Steps variant="column" fade={false} />
      </div>
      <p class="connect-assure" data-hero><Rich text={c.assurance} /></p>
    </div>

    <form id="connect-form" class="connect-form" data-hero novalidate>
      <div class="field">
        <label for="name">{f.name}</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="email">{f.email}</label>
        <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-hint" />
        <p class="hint" id="email-hint">{f.emailHint}</p>
      </div>
      <div class="field">
        <label for="phone">{f.phone} <span class="optional">{f.optional}</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="field connect-kept" data-connect-kept hidden>
        <p class="field-label" id="kept-label">{f.kept}</p>
        <ul class="kept-chips" data-connect-kept-list aria-labelledby="kept-label"></ul>
        <p class="hint">{f.keptHint}</p>
        <input type="hidden" name="kept" data-connect-kept-value />
      </div>
      <div class="field">
        <label for="topic">{f.topic} <span class="optional">{f.optional}</span></label>
        <textarea id="topic" name="topic" rows="2" placeholder={f.topicExample}></textarea>
      </div>
      <fieldset class="field">
        <legend>{f.times}</legend>
        <p class="hint" data-tz-hint data-text={f.timesHint}></p>
        <div class="times">
          <label class="time"><span>{f.first}</span><input id="time1" name="time1" type="datetime-local" required /></label>
          <label class="time"><span>{f.second} <span class="optional">{f.optional}</span></span><input id="time2" name="time2" type="datetime-local" /></label>
          <label class="time"><span>{f.third} <span class="optional">{f.optional}</span></span><input id="time3" name="time3" type="datetime-local" /></label>
        </div>
      </fieldset>
      <!-- left empty by people; robots fill it in -->
      <div class="hp" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <p class="notice">{f.privacy}</p>
      <p class="connect-error" data-connect-error role="alert" hidden></p>
      <button type="submit" class="btn btn-solid" data-connect-send data-sending={d.sending}>{f.send}</button>
      {mode === 'demo' && <p class="proto-note">{c.preview}</p>}
      {mode === 'off' && <p class="proto-note">Prototype: this copy of the site has no Studio behind it, so nothing is sent from here.</p>}
    </form>

    <div id="connect-done" class="connect-done" hidden tabindex="-1" data-error={d.error}>
      <h2 class="display-m">{mode === 'off' ? c.done.title : d.title}</h2>
      <p class="lede">{mode === 'off' ? c.done.text : d.text}</p>
      <div data-done-times hidden><p class="kicker">{d.times}</p><ul class="bk-times"></ul></div>
      <div class="bk-asked" data-done-asked hidden><p class="kicker">{d.asked}</p><ul class="kept-chips bk-chips"></ul><p class="bk-quote" data-done-topic hidden></p></div>
      <p class="hint" data-done-cleared hidden>{d.cleared}</p>
      <div class="cta-row">
        <a class="btn btn-solid" href="/booking" data-done-track hidden>{d.track}</a>
        <a class="btn btn-ghost" href="/">{d.back}</a>
      </div>
    </div>
  </section>
</Base>
