---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import { pillars, totalServices } from '../data/site';
import kind from '../data/kind-words.json';
---
<Base title="Sarvakali">
  <Loader slot="overlay" />

  <section class="chapter chapter-hero" data-chapter="hero" data-hero-chapter>
    <div class="chapter-inner">
      <div class="hero-eye" aria-hidden="true">
        <svg viewBox="-90 -125 180 250">
          <defs>
            <radialGradient id="he-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#ffcf7a" stop-opacity="0.55" />
              <stop offset="0.5" stop-color="#f0903a" stop-opacity="0.16" />
              <stop offset="1" stop-color="#f0903a" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="he-iris-g" cx="50%" cy="45%" r="55%">
              <stop offset="0" stop-color="#ffd98e" />
              <stop offset="0.45" stop-color="#e2622f" />
              <stop offset="1" stop-color="#3b0907" />
            </radialGradient>
            <clipPath id="he-clip"><path d="M0 -100 Q74 0 0 100 Q-74 0 0 -100Z" /></clipPath>
          </defs>
          <circle class="he-glow" r="120" fill="url(#he-glow)" />
          <g id="he-open">
            <path d="M0 -100 Q74 0 0 100 Q-74 0 0 -100Z" fill="#1c0807" />
            <g clip-path="url(#he-clip)">
              <g id="he-iris">
                <circle r="27" fill="url(#he-iris-g)" />
                <circle r="9" fill="#080203" />
                <circle cx="-8" cy="-9" r="4" fill="#fff" opacity="0.8" />
              </g>
            </g>
            <path d="M0 -100 Q74 0 0 100 Q-74 0 0 -100Z" fill="none" stroke="#f0b34a" stroke-width="2.6" />
          </g>
        </svg>
      </div>
      <p class="kicker" data-hero data-hero-kicker>Welcome to</p>
      <h1 class="display-xl hero-title" data-hero data-split>Sarvakali</h1>
      <p class="lede" data-hero>Devotion, magic, healing and insight, held in one place.</p>
      <div class="cta-row" data-hero>
        <a class="btn btn-solid" href="/connect">Request a conversation</a>
        <a class="btn btn-ghost" href="#paths">Explore the six pillars</a>
      </div>
    </div>
    <p class="scroll-cue" data-hero aria-hidden="true">Scroll</p>
  </section>

  <section class="chapter chapter-connect" data-chapter="connect">
    <div class="chapter-inner narrow">
      <p class="kicker" data-fade>Connect</p>
      <h2 class="display-l" data-split data-dust>Speak with Sarvakali</h2>
      <p class="lede" data-fade>
        Share your name and a few times that suit you. Sarvakali confirms the meeting or suggests another time, and you meet over Google Meet.
      </p>
      <div class="cta-row" data-fade>
        <a class="btn btn-solid" href="/connect">Request a conversation</a>
        <a class="btn btn-ghost" href="/path">Not sure where to begin? Find your path</a>
      </div>
      <ol class="how" aria-label="How it works">
        <li data-fade>
          <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="12" width="34" height="24" rx="4" /><path d="M8 14l16 12 16-12" /></svg>
          <b>Request a time</b>
          <span>Your name, email and a few times that suit you. Nothing about your situation.</span>
        </li>
        <li data-fade>
          <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="10" width="32" height="30" rx="4" /><path d="M8 18h32M16 6v8M32 6v8M17 29l5 5 9-10" /></svg>
          <b>Sarvakali confirms</b>
          <span>The time is confirmed, or another one is suggested.</span>
        </li>
        <li data-fade>
          <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="13" width="26" height="22" rx="4" /><path d="M32 21l10-6v18l-10-6z" /></svg>
          <b>Meet on Google Meet</b>
          <span>The link arrives by email. Join from your phone or computer.</span>
        </li>
        <li data-fade>
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M14 10h22M14 18h22M14 10c10 0 14 4 14 8s-4 8-14 8l16 14" /></svg>
          <b>Pay by UPI</b>
          <span>An invoice with a UPI QR code. No card details, ever.</span>
        </li>
      </ol>
    </div>
  </section>

  <div id="paths" class="anchor"></div>

  {pillars.map((p, i) => (
    <section class="chapter chapter-pillar" data-chapter={p.preset}>
      <div class="chapter-inner">
        <p class="kicker" data-fade>Pillar {i + 1} of {pillars.length}</p>
        <h2 class="display-l" data-split data-dust transition:name={`pt-${p.slug}`} data-pt>{p.name}</h2>
        <p class="lede" data-fade>{p.line}</p>
        <ul class="chips" data-fade>
          {p.categories.map((c) => <li>{c.name}</li>)}
        </ul>
        <div class="cta-row" data-fade>
          <a class="btn btn-solid" href={`/pillars/${p.slug}`}>Explore this pillar</a>
          <a class="btn btn-ghost" href="/connect" data-topic={p.name}>Ask about this</a>
          {p.slug === 'divination' && <button type="button" class="btn btn-ghost" data-card-open>Draw today's card</button>}
        </div>
      </div>
    </section>
  ))}

  <section class="chapter chapter-kind" data-chapter="kind">
    <div class="chapter-inner center">
      <p class="kicker" data-fade>Kind words</p>
      <h2 class="display-l" data-split data-dust>From people who have sat with Sarvakali</h2>
      <ul class="kind-words">
        {kind.words.map((w) => (
          <li class="kind-card" data-fade data-drift>
            <blockquote>“{w.text}”</blockquote>
            <span>{w.who} · {w.where}</span>
          </li>
        ))}
      </ul>
      <p class="proto-flag" data-fade>Sample words for the prototype. Real ones are shared only with each person's permission.</p>
    </div>
  </section>

  <section class="chapter chapter-close" data-chapter="close" id="close">
    <div class="chapter-inner narrow center">
      <div class="diya" data-diya data-fade>
        <svg class="diya-svg" viewBox="0 0 160 130" aria-hidden="true">
          <defs>
            <radialGradient id="diya-glow" cx="50%" cy="60%" r="50%">
              <stop offset="0" stop-color="#ffd27a" stop-opacity="0.75" />
              <stop offset="0.4" stop-color="#f0903a" stop-opacity="0.25" />
              <stop offset="1" stop-color="#f0903a" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="diya-flame-g" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#fff7df" />
              <stop offset="0.35" stop-color="#ffc35a" />
              <stop offset="1" stop-color="#e2492a" stop-opacity="0.85" />
            </linearGradient>
            <linearGradient id="diya-clay" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#b0552c" />
              <stop offset="1" stop-color="#5a2312" />
            </linearGradient>
          </defs>
          <circle class="diya-halo" cx="80" cy="52" r="60" fill="url(#diya-glow)" />
          <g class="diya-flame">
            <path d="M80 70 C70 58 72 44 80 26 C88 44 90 58 80 70 Z" fill="url(#diya-flame-g)" />
            <path d="M80 68 C76 62 77 55 80 47 C83 55 84 62 80 68 Z" fill="#fffaf0" opacity="0.9" />
          </g>
          <path d="M80 70 L80 76" stroke="#2a120a" stroke-width="2.4" stroke-linecap="round" />
          <path d="M22 78 Q80 74 132 72 L142 66 Q140 80 128 86 Q80 122 32 92 Q22 86 22 78 Z" fill="url(#diya-clay)" />
          <path d="M26 80 Q80 76 134 74" fill="none" stroke="#e08a52" stroke-width="1.4" opacity="0.7" />
        </svg>
        <button type="button" class="btn btn-ghost" data-diya-light>Light a diya</button>
        <p class="diya-count" data-diya-count aria-live="polite"></p>
      </div>
      <p class="kicker" data-fade>When you are ready</p>
      <h2 class="display-l" data-split>Every path begins with a conversation</h2>
      <div class="cta-row center" data-fade>
        <a class="btn btn-solid" href="/connect">Request a conversation</a>
        <a class="btn btn-ghost" href="/path">Find your path</a>
      </div>
      <p class="moon-line" data-fade data-moon-line></p>
      <p class="practice-link" data-fade><a href="/practice">A little practice for today →</a></p>
    </div>
  </section>

  <footer class="site-foot">
    <p>Sarvakali · working prototype. Copy, colours and the intro artwork are placeholders.</p>
    <p><a href="/path">Find your path</a> · <a href="/practice">Daily practice</a> · <a href="/writings">Writings</a> · <a href="/about">About</a> · <a href="/care">Boundaries and care</a> · <a href="/depth">AI depth demo</a></p>
    <p>{totalServices.toLocaleString('en-IN')} services across {pillars.length} pillars.</p>
  </footer>
</Base>
