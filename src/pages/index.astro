---
import { pageMeta as PM } from '../config';
import Base from '../layouts/Base.astro';
import { organisation, website } from '../seo/ld';
import TodayLine from '../components/TodayLine.astro';
import ThirdEye from '../components/ThirdEye.astro';
import Loader from '../components/Loader.astro';
import Steps from '../components/Steps.astro';
import { pillars } from '../data/site';
import kind from '../content/kind-words.json';
import home from '../content/home.json';

const h = home;
const words = kind.words.filter((w) => w.text.trim());
---
<Base title={PM.home.title} description={PM.home.description} ld={[organisation(), website()]}>
  <Loader slot="overlay" />

  <section class="chapter chapter-hero" data-chapter="hero" data-hero-chapter>
    <div class="chapter-inner">
      <div class="hero-eye" aria-hidden="true">
        <svg viewBox="-180 -245 360 490">
          <defs>
            <radialGradient id="he-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#ffcf7a" stop-opacity="0.5" />
              <stop offset="0.5" stop-color="#f0903a" stop-opacity="0.14" />
              <stop offset="1" stop-color="#f0903a" stop-opacity="0" />
            </radialGradient>
          </defs>
          <circle class="he-glow" r="230" fill="url(#he-glow)" />
          <!-- the same third eye as the opening's (src/components/ThirdEye.astro); its iris follows the cursor -->
          <ThirdEye cx={0} cy={0} prefix="he" raysOpacity={0.6} />
        </svg>
      </div>
      <p class="kicker" data-hero data-hero-kicker>{h.hero.kicker}</p>
      <h1 class="display-xl hero-title" data-hero data-split>{h.hero.title}</h1>
      <p class="lede" data-hero>{h.hero.lede}</p>
      <div class="cta-row" data-hero>
        <a class="btn btn-solid" href="/connect">{h.hero.primary}</a>
        <a class="btn btn-ghost" href="#paths">{h.hero.secondary}</a>
      </div>
    </div>
    <p class="scroll-cue" data-hero aria-hidden="true">{h.hero.scroll}</p>
  </section>

  <section class="chapter chapter-connect" data-chapter="connectHome">
    <div class="chapter-inner narrow">
      <p class="kicker" data-fade>{h.connect.kicker}</p>
      <h2 class="display-l" data-split data-dust>{h.connect.title}</h2>
      <p class="lede" data-fade>{h.connect.lede}</p>
      <div class="cta-row" data-fade>
        <a class="btn btn-solid" href="/connect">{h.connect.primary}</a>
        <a class="btn btn-ghost" href="/path">{h.connect.secondary}</a>
      </div>
      <Steps />
    </div>
  </section>

  <div id="paths" class="anchor"></div>

  {pillars.map((p, i) => (
    <section class="chapter chapter-pillar" data-chapter={p.preset}>
      <div class="chapter-inner">
        <p class="kicker" data-fade>Pillar {i + 1} of {pillars.length}</p>
        <h2 class="display-l" data-split data-dust transition:name={`pt-${p.slug}`} data-pt>{p.name}</h2>
        <p class="lede" data-fade>{p.line}</p>
        <ul class="chips" data-fade>
          {p.categories.map((c) => <li>{c.name}</li>)}
        </ul>
        <div class="cta-row" data-fade>
          <a class="btn btn-solid" href={`/pillars/${p.slug}`}>{h.pillars.explore}</a>
          <a class="btn btn-ghost" href="/connect" data-topic={p.name}>{h.pillars.ask}</a>
        </div>
      </div>
    </section>
  ))}

  <TodayLine />

  <section class="chapter chapter-kind" data-chapter="kind">
    <div class="chapter-inner center">
      <p class="kicker" data-fade>{h.kind.kicker}</p>
      <h2 class="display-l" data-split data-dust>{h.kind.title}</h2>
      <ul class="kind-words">
        {words.map((w) => (
          <li class="kind-card" data-fade data-drift>
            <blockquote>“{w.text}”</blockquote>
            <span>{w.who} · {w.where}</span>
          </li>
        ))}
      </ul>
      {h.kind.note && <p class="proto-flag" data-fade>{h.kind.note}</p>}
    </div>
  </section>

  <section class="chapter chapter-close" data-chapter="close" id="close">
    <div class="chapter-inner narrow center">
      <div class="diya" data-diya data-fade>
        <svg class="diya-svg" viewBox="0 0 160 130" aria-hidden="true">
          <defs>
            <radialGradient id="diya-glow" cx="50%" cy="60%" r="50%">
              <stop offset="0" stop-color="#ffd27a" stop-opacity="0.75" />
              <stop offset="0.4" stop-color="#f0903a" stop-opacity="0.25" />
              <stop offset="1" stop-color="#f0903a" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="diya-flame-g" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#fff7df" />
              <stop offset="0.35" stop-color="#ffc35a" />
              <stop offset="1" stop-color="#e2492a" stop-opacity="0.85" />
            </linearGradient>
            <linearGradient id="diya-clay" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#b0552c" />
              <stop offset="1" stop-color="#5a2312" />
            </linearGradient>
          </defs>
          <circle class="diya-halo" cx="80" cy="52" r="60" fill="url(#diya-glow)" />
          <g class="diya-flame">
            <path d="M80 70 C70 58 72 44 80 26 C88 44 90 58 80 70 Z" fill="url(#diya-flame-g)" />
            <path d="M80 68 C76 62 77 55 80 47 C83 55 84 62 80 68 Z" fill="#fffaf0" opacity="0.9" />
          </g>
          <path d="M80 70 L80 76" stroke="#2a120a" stroke-width="2.4" stroke-linecap="round" />
          <path d="M22 78 Q80 74 132 72 L142 66 Q140 80 128 86 Q80 122 32 92 Q22 86 22 78 Z" fill="url(#diya-clay)" />
          <path d="M26 80 Q80 76 134 74" fill="none" stroke="#e08a52" stroke-width="1.4" opacity="0.7" />
        </svg>
        <button type="button" class="btn btn-ghost" data-diya-light>{h.close.diya}</button>
        <p class="diya-count" data-diya-count aria-live="polite"></p>
      </div>
      <p class="kicker" data-fade>{h.close.kicker}</p>
      <h2 class="display-l" data-split>{h.close.title}</h2>
      <div class="cta-row center" data-fade>
        <a class="btn btn-solid" href="/connect">{h.close.primary}</a>
        <a class="btn btn-ghost" href="/path">{h.close.secondary}</a>
      </div>
      <p class="moon-line" data-fade data-moon-line></p>
      <p class="practice-link" data-fade><a href="/practice">{h.close.practice}</a></p>
    </div>
  </section>

</Base>
