---
/**
 * The opening: the Devi's face, drawn for Sarvakali in the bold, simple manner of the traditional face (third eye,
 * crescent and bindi, winged eyes, sweeping brows, nose ring and lips), as light on darkness. An original drawing;
 * no stock artwork is used. A lean, long face with a faint outline of cheek and chin; the third eye at its heart,
 * flame-shaped, framed in gold and ringed with rays. The choreography: darkness, the brows and the eyes appear, the
 * eyes open and blink twice, the crescent and bindi glow, light gathers and the third eye opens within its rays, then
 * we fly into the third eye and an eye-shaped opening reveals the site (src/scripts/loader.ts).
 */
import { words as SW } from '../config';
import ThirdEye from './ThirdEye.astro';
import { thirdPath } from '../data/third-eye';

// everything in a 1600 × 1000 space; the right half is the left half mirrored about x = 800
const E3 = { x: 800, y: 300 }; // the third eye
const third = thirdPath(E3.x, E3.y);
const M = 'matrix(-1 0 0 1 1600 0)'; // mirror

// the left eye (the visitor's left): a lean almond with a long upswept wing at its outer corner
const eyeOpen = 'M712 528 Q640 464 548 478 Q522 484 506 494 Q530 528 566 540 Q648 562 712 528Z';
const liner = 'M724 534 Q646 450 548 466 Q500 474 436 428 Q468 474 502 500 Q530 486 552 482 Q640 472 712 528Z';
const lower = 'M712 528 Q640 572 560 548 Q526 538 506 508 Q534 552 566 560 Q650 584 716 532Z';
const brow = 'M772 420 Q664 300 428 258 Q652 288 784 406Z';
const cheek = 'M478 352 C456 470 486 610 566 756 C626 866 722 930 800 936';
const iris = { x: 640, y: 508, r: 34 };

// motes of light that gather into the third eye (deterministic scatter)
let s = 7;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const motes = Array.from({ length: 56 }, () => {
  const a = rand() * Math.PI * 2;
  const r = 180 + rand() * 520;
  return { x: E3.x + Math.cos(a) * r * 1.3, y: E3.y + Math.sin(a) * r * 0.8, r: 1.2 + rand() * 2.6 };
});
// the nose ring hangs from the right nostril; its beads along its lower right
const nath = { x: 878, y: 786, r: 92 };
const beads = [12, 28, 44, 60].map((deg, i) => {
  const a = (deg * Math.PI) / 180;
  return { x: nath.x + Math.cos(a) * nath.r, y: nath.y + Math.sin(a) * nath.r, r: i % 2 ? 8 : 11 };
});
---
<div id="loader" class="loader" role="dialog" aria-label={SW.opening} aria-modal="false">
  <svg class="loader-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="lg-ember" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#7a1c12" stop-opacity="0.55" />
        <stop offset="0.55" stop-color="#3a0c09" stop-opacity="0.25" />
        <stop offset="1" stop-color="#060304" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="lg-iris" cx="50%" cy="45%" r="55%">
        <stop offset="0" stop-color="#ffd98e" />
        <stop offset="0.45" stop-color="#e2622f" />
        <stop offset="1" stop-color="#3b0907" />
      </radialGradient>
      <radialGradient id="lg-third" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#fff4cf" stop-opacity="0.95" />
        <stop offset="0.35" stop-color="#f3ad45" stop-opacity="0.55" />
        <stop offset="1" stop-color="#f3ad45" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="lg-sindoor" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#ff6a4f" stop-opacity="0.7" />
        <stop offset="1" stop-color="#ff6a4f" stop-opacity="0" />
      </radialGradient>
      <clipPath id="lc-L"><path d={eyeOpen} /></clipPath>
      <mask id="lm-hole" maskUnits="userSpaceOnUse" x="-4000" y="-4000" width="9600" height="9000">
        <rect x="-4000" y="-4000" width="9600" height="9000" fill="#fff" />
        <path id="loader-hole" d={third} fill="#000" />
      </mask>
    </defs>

    <g mask="url(#lm-hole)">
      <rect x="-4000" y="-4000" width="9600" height="9000" fill="#060304" />
      <g id="loader-face">
        <circle id="loader-ember" cx="800" cy="520" r="620" fill="url(#lg-ember)" opacity="0" />

        <g id="loader-eyes" opacity="0">
          {[null, M].map((t) => (
            <g transform={t ?? undefined}>
              <path d={cheek} fill="none" stroke="#f1e3c8" stroke-width="3" stroke-linecap="round" opacity="0.16" />
              <path d={brow} fill="#f1e3c8" />
              <g class="l-eye">
                <path d={eyeOpen} fill="#f6ecdc" />
                <g clip-path="url(#lc-L)">
                  <g class="l-iris">
                    <circle cx={iris.x} cy={iris.y} r={iris.r} fill="#120506" />
                    <circle cx={iris.x} cy={iris.y} r={iris.r - 7} fill="url(#lg-iris)" opacity="0.55" />
                    <circle cx={iris.x} cy={iris.y} r="12" fill="#080203" />
                    <circle cx={iris.x + 11} cy={iris.y - 10} r="6.5" fill="#fff" />
                  </g>
                  <g class="l-lid">
                    <rect x="480" y="430" width="270" height="160" fill="#0d0405" />
                  </g>
                </g>
                <path d={liner} fill="#f1e3c8" />
                <path d={lower} fill="#f1e3c8" opacity="0.85" />
              </g>
            </g>
          ))}
        </g>

        <g id="loader-marks" opacity="0">
          <circle cx="800" cy="470" r="70" fill="url(#lg-sindoor)" />
          <path d="M744 430 Q800 494 856 430 Q800 472 744 430Z" fill="#e2463e" />
          <circle cx="800" cy="502" r="15" fill="#e2463e" />
        </g>

        <g id="loader-lower" opacity="0">
          <!-- the nose: its bridge, and the curve of its base with the nostrils -->
          <path d="M772 556 Q780 622 768 670" fill="none" stroke="#f1e3c8" stroke-width="4" stroke-linecap="round" opacity="0.5" />
          <path d="M748 684 Q750 708 774 706 Q788 718 800 716 Q812 718 826 706 Q850 708 852 684" fill="none" stroke="#f1e3c8" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M790 722 Q791 750 794 776 M810 722 Q809 750 806 776" fill="none" stroke="#f1e3c8" stroke-width="2.5" stroke-linecap="round" opacity="0.22" />
          <!-- the lips: a cupid's bow above, a fuller lower lip, the line between and a soft light -->
          <path d="M722 798 C746 786 770 770 790 778 C795 780 798 783 800 783 C802 783 805 780 810 778 C830 770 854 786 878 798 C852 803 828 805 800 805 C772 805 748 803 722 798Z" fill="#b8282f" />
          <path d="M726 800 C752 808 776 811 800 811 C824 811 848 808 874 800 C860 840 830 856 800 856 C770 856 740 840 726 800Z" fill="#e2463e" />
          <path d="M714 798 C756 809 844 809 886 798" fill="none" stroke="#2a0c0a" stroke-width="5" stroke-linecap="round" />
          <ellipse cx="800" cy="830" rx="30" ry="6" fill="#fff" opacity="0.2" />
          <!-- the nose ring -->
          <circle cx={nath.x} cy={nath.y} r={nath.r} fill="none" stroke="#e8b04f" stroke-width="5" />
          {beads.map((b) => <circle cx={b.x} cy={b.y} r={b.r} fill="#e8b04f" />)}
        </g>

        <g id="loader-third">
          <circle id="loader-third-glow" cx={E3.x} cy={E3.y} r="230" fill="url(#lg-third)" opacity="0" />
          <line id="loader-third-line" x1={E3.x} y1={E3.y - 112} x2={E3.x} y2={E3.y + 112} stroke="#f0b34a" stroke-width="3" stroke-linecap="round" opacity="0" />
          <g id="loader-third-all">
            <ThirdEye cx={E3.x} cy={E3.y} prefix="loader-third" raysOpacity={0} core />
          </g>
        </g>

        <g id="loader-motes" fill="#f6c46c">
          {motes.map((m) => <circle cx={m.x} cy={m.y} r={m.r} opacity="0" />)}
        </g>
      </g>
    </g>
  </svg>

  <button type="button" class="loader-skip" id="loader-skip">{SW.skipIntro}</button>
</div>
