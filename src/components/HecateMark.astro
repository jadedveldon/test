---
/**
 * Hecate's key, small, for the mark beside her name: the main strokes and the glows of the drawing the light form
 * uses (src/data/hecate-key.ts); the finer detail is left out, as it would blur at this size.
 */
import { KEY } from '../data/hecate-key';
interface Props { x?: number; y?: number; size?: number }
const { x = 0, y = 0, size = 400 } = Astro.props;
const t = KEY.transform;
---
<svg class="hk-sign" x={x} y={y} width={size} height={size} viewBox="0 0 400 400" aria-hidden="true">
  <g data-sign="key" transform={`translate(${t[0]} ${t[1]}) rotate(${t[2]}) scale(${t[3]})`}>
    {KEY.glows.map((d) => <path d={d} class="hk-sign-glow" />)}
    {KEY.lines.map((d) => <path d={d} class="hk-sign-line" />)}
  </g>
</svg>
