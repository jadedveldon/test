---
/**
 * The Kali yantra, drawing itself line by line as you scroll a pillar page (src/scripts/app.ts): the bindu, five
 * downward triangles, three circles, the lotus of eight petals, the great circle and the gated square. Its geometry is
 * shared with the world's yantra (src/data/kali-yantra.ts).
 */
import { KALI_YANTRA, yantraLines, lineD } from '../data/kali-yantra';
const lines = yantraLines();
---
<div class="yantra" aria-hidden="true">
  <svg viewBox="-330 -330 660 660">
    <g class="y-lines" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round">
      <circle class="y-path" r={KALI_YANTRA.bindu.ring} pathLength="1" />
      {lines.map((l) => <path class="y-path" d={lineD(l)} pathLength="1" />)}
    </g>
    <circle class="y-bindu" r={KALI_YANTRA.bindu.r} fill="currentColor" />
  </svg>
</div>
